-    px.forEach((p, idx) => {
-      let bi = 0
-      let bd = Infinity
-      cents.forEach((c, ci) => {
-        const d = (c[0] - p[0]) ** 2 + (c[1] - p[1]) ** 2 + (c[2] - p[2]) ** 2
-        if (d < bd) { bd = d; bi = ci }
-      })
-      assign[idx] = bi
-    })
-    for (let k = 0; k < K; k++) {
-      let n = 0
-      let sr = 0, sg = 0, sb = 0
-      assign.forEach((a, idx) => { if (a === k) { n++; sr += px[idx][0]; sg += px[idx][1]; sb += px[idx][2] } })
