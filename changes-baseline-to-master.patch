+.sl-job-h em { font-style: normal; font-family: var(--vl-mono); }
+.sl-job-bar { height: var(--vl-s1); border-radius: 3px; background: var(--vl-surface-sunk); overflow: hidden; }
+.sl-job-bar i { display: block; height: 100%; background: var(--vl-accent); }
