+.sl-sk-row { display: grid; grid-template-columns: 20px 1fr 60px; align-items: center; gap: var(--vl-s3); }
+.sl-sk-dot { width: var(--vl-s5); height: var(--vl-s5); border-radius: 50%; background: var(--vl-surface-sunk); }
+.sl-sk-line { height: var(--vl-s3); border-radius: 5px; background: var(--vl-surface-sunk); }
+.sl-sk-num { height: var(--vl-s3); border-radius: 5px; background: var(--vl-surface-sunk); }
+.sl-shimmer {
