+}
+.ax-modal-copy-btn:hover { transform: translateY(-1px); }
+.ax-modal-copy-btn.copied { background: var(--vl-verify); }
+
+/* ============ 专精生态标杆库 ============ */
+.ax-curated-sec { margin-top: var(--vl-s4); }
+.ax-curated-list { display: flex; flex-direction: column; gap: 7px; margin-top: var(--vl-s1); }
+.ax-curated-item {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  padding: var(--vl-s2) 11px;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  text-decoration: none;
+  transition: all var(--vl-dur-1) var(--vl-ease-out);
+}
+.ax-curated-item:hover {
+  border-color: var(--vl-line-strong);
+  transform: translateY(-1px);
+  box-shadow: var(--vl-shadow-1);
+}
+.ax-curated-item-h { display: flex; align-items: center; justify-content: space-between; gap: var(--vl-s2); }
+.ax-curated-item-h b { font-size: var(--vl-fs-xs); color: var(--vl-ink); font-weight: var(--vl-fw-bold); }
+.ax-curated-tag {
+  font-size: var(--vl-fs-2xs);
+  padding: 2px var(--vl-s1);
+  border-radius: var(--vl-r-pill);
+  background: var(--vl-accent-wash);
+  color: var(--vl-accent);
+  font-weight: var(--vl-fw-medium);
+}
+.ax-curated-item p { margin: 0; font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); line-height: var(--vl-lh-2xs); }
+
+/* ============================================================
+   断点：只有 768 / 1280 三条 min-width（1440 不改图鉴结构）
+   ============================================================ */
+@media (min-width: 768px) {
+  .fm-cols { grid-template-columns: 1fr 1fr; }
+  .dd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .dd-span2 { grid-column: span 2; }
+  .nv-body { grid-template-columns: var(--nv-rail) minmax(0, 1fr); }
+  .pg-main { grid-template-columns: minmax(0, 1fr) 190px; }
+}
+
+@media (min-width: 1280px) {
+  .dd-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+}
+
+/* ---- reduce-motion：关掉动画不等于关掉信息（方案 §7.4 第 9 条） ---- */
+@media (prefers-reduced-motion: reduce) {
+  .tr-chars .tr-ch,
+  .tr-mask,
+  .tr-marquee-track,
+  .tr-shimmer,
+  .sn-on::after,
+  .tr-caret,
+  .ac-cursor,
+  .ov-panel,
+  .ov-backdrop,
+  .fm-cb-caret,
+  .st-scroll-track,
+  .st-layer,
+  .st-scroll-item,
+  .st-progress i,
+  .sl-loader i,
+  .sl-shimmer { animation: none; }
+  .tr-chars .tr-ch { opacity: 1; transform: none; filter: none; }
+  .tr-mask { clip-path: none; }
+  .sn-on::after { outline: 2px solid var(--vl-accent); }
+  .st-detail, .st-row-body, .st-track { transition-duration: 1ms; }
+  .st-scroll-reveal .st-scroll-item, .st-scroll-driven .st-scroll-item { opacity: 1; }
+}
diff --git a/frontend/src/styles/base.css b/frontend/src/styles/base.css
new file mode 100644
index 0000000..21a3728
--- /dev/null
+++ b/frontend/src/styles/base.css
@@ -0,0 +1,104 @@
+/* ============================================================
+   基础层：reset、字体加载、全局排版、焦点环、reduce-motion、inert
+   本文件不得出现 hex / rgb / hsl 字面量，颜色一律取 tokens.css。
+   ============================================================ */
+
+/* Inter 只管拉丁与常用标点；汉字由 --vl-sans 里显式写出的中文栈承担。
+   font-synthesis: none —— 禁止浏览器伪造粗体，中英混排字重才统一。 */
+@font-face {
+  font-family: 'Inter Variable';
+  src: url('/fonts/inter-variable-latin.woff2') format('woff2');
+  font-style: normal;
+  font-weight: 100 900;
+  font-display: swap;
+  unicode-range: U+0000-00FF, U+2000-206F, U+2190-21BB, U+2212, U+2215;
+}
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+html {
+  scroll-behavior: smooth;
+  overflow-x: clip;
+  min-width: 0;
+  min-height: 100%;
+}
+
+body {
+  margin: 0;
+  padding: 0;
+  min-width: 0;
+  min-height: 100%;
+  overflow-x: clip;
+  background: var(--vl-bg);
+  color: var(--vl-ink-2);
+  font-family: var(--vl-sans);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-md);
+  font-synthesis: none;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+#root {
+  width: auto;
+  max-width: none;
+  min-width: 0;
+  min-height: 100svh;
+  display: flex;
+  flex-direction: column;
+  border: 0;
+}
+
+a { color: inherit; text-decoration: none; }
+button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
+input, select, textarea { font: inherit; color: inherit; }
+img { max-width: 100%; }
+
+::selection { background: var(--vl-accent); color: var(--vl-accent-ink); }
+
+/* 等宽元数据：最小 12px，必须配 --vl-ink-3（方案 §7.4 第 3 条） */
+.x-mono {
+  font-family: var(--vl-mono);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  letter-spacing: 0.04em;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* ---- 焦点环（方案 §7.2.9）：两层环，任何底色上都可见 ---- */
+:where(a, button, input, select, textarea, [tabindex]):focus-visible {
+  outline: none;
+  box-shadow: var(--vl-focus-ring);
+  border-radius: var(--vl-r-sm);
+}
+
+/* ---- 关闭态浮层：不可点、不可选、不可 Tab 进入（方案 §7.4 第 2 条） ---- */
+[inert] {
+  pointer-events: none;
+  user-select: none;
+  cursor: default;
+}
+
+/* ---- reduce-motion 全局兜底 ---- */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after {
+    scroll-behavior: auto !important;
+    animation-duration: .001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .001ms !important;
+  }
+}
diff --git a/frontend/src/styles/curation.css b/frontend/src/styles/curation.css
new file mode 100644
index 0000000..2311ca3
--- /dev/null
+++ b/frontend/src/styles/curation.css
@@ -0,0 +1,622 @@
+/* ============================================================
+   策展层：策展首页（分组卡片墙）与全部站点（兜底列表）。
+   WP-D 全量重写——旧的 .oreo-* / .catalog-* 规则连同 IndexView / SiteCatalog
+   一起退场，本文件不再保留任何旧选择器。
+
+   气质（方案 §7.1）：一份印刷精良的工具书，不是 SaaS 落地页。
+   - 底色是暖灰纸面，内容坐落在白色板面上
+   - 只有一种强调色（近黑）；深绿只表示「已核验」这一件事
+   - 一档圆角（--vl-r-sm）、一档阴影（只给悬停的卡）、无渐变、无跑马灯、无 emoji
+   - 等宽字只用于核验日期与许可证代码
+   本文件不得出现 hex / rgb / hsl 字面量与裸 px 字号。
+   ============================================================ */
+
+/* ---------------------------------------------------------------
+   1. 页面骨架
+   --------------------------------------------------------------- */
+
+.vl-curation,
+.vl-allsites {
+  width: var(--vl-container);
+  margin-inline: auto;
+  padding-bottom: var(--vl-s10);
+}
+
+.vl-sep {
+  margin-inline: var(--vl-s2);
+  color: var(--vl-line-strong);
+}
+
+.vl-num {
+  color: var(--vl-ink);
+  font-weight: var(--vl-fw-bold);
+  font-variant-numeric: tabular-nums;
+}
+
+.vl-num.is-empty {
+  color: var(--vl-ink-3);
+  font-weight: var(--vl-fw-regular);
+}
+
+.vl-quiet-link {
+  color: var(--vl-ink-2);
+  border-bottom: 1px solid var(--vl-line-strong);
+  padding-bottom: 1px;
+}
+
+.vl-quiet-link:hover { color: var(--vl-ink); border-bottom-color: var(--vl-accent); }
+
+.vl-dash { color: var(--vl-ink-3); }
+
+.vl-alert {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s3);
+  margin: var(--vl-s5) 0 0;
+  padding: var(--vl-s3) var(--vl-s4);
+  border: 1px solid var(--vl-danger);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-danger-wash);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+.vl-alert button {
+  padding: var(--vl-s1) var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  font-size: var(--vl-fs-xs);
+}
+
+/* ---------------------------------------------------------------
+   2. 承诺句区（首屏第一件事）
+   --------------------------------------------------------------- */
+
+.vl-promise {
+  padding-block: var(--vl-s7) var(--vl-s6);
+}
+
+.vl-promise-title {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-2xl);
+  line-height: var(--vl-lh-2xl);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -0.01em;
+}
+
+/* 一行放完；放不下就整段整段地换行，日期与数字不会被折断 */
+.vl-promise-line {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s1) var(--vl-s4);
+  margin: var(--vl-s4) 0 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+.vl-promise-part { white-space: nowrap; }
+
+/* 分隔点跟在前一段的尾巴上，于是换行后新的一行不会以「·」开头 */
+.vl-promise-part:not(:last-child)::after {
+  content: '·';
+  margin-left: var(--vl-s4);
+  color: var(--vl-line-strong);
+}
+
+.vl-promise-line time { color: var(--vl-ink-2); }
+
+/* ---------------------------------------------------------------
+   3. 分组：一个标题 + 一句说明 + 一排卡片
+   --------------------------------------------------------------- */
+
+.vl-group {
+  padding-top: var(--vl-s7);
+  border-top: 1px solid var(--vl-line);
+}
+
+.vl-group + .vl-group { margin-top: var(--vl-s8); }
+
+.vl-group-title {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-lg);
+  line-height: var(--vl-lh-lg);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -0.01em;
+}
+
+.vl-group-blurb {
+  margin: var(--vl-s2) 0 0;
+  max-width: 62ch;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+/* 卡片墙：单列起步，逐档加列。不横滑、不表格、不做轴行。 */
+.vl-group-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  align-items: start;
+  gap: var(--vl-s4);
+  margin-top: var(--vl-s5);
+}
+
+/* ---------------------------------------------------------------
+   4. 卡片：五项，不多不少
+   --------------------------------------------------------------- */
+
+.vl-card-shot {
+  display: block;
+  position: relative;
+  overflow: hidden;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+}
+
+.vl-card-shot img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: top center;
+}
+
+.vl-domain-mark {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  height: 100%;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-3xl);
+  line-height: 1;
+  font-weight: var(--vl-fw-bold);
+}
+
+.vl-card-name {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -0.01em;
+}
+
+.vl-take {
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 3;
+  line-clamp: 3;
+  overflow: hidden;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-unwritten {
+  color: var(--vl-ink-3);
+  text-decoration: underline dashed var(--vl-line-strong);
+  text-underline-offset: 3px;
+}
+
+.vl-card:hover .vl-card-shot { border-color: var(--vl-line-strong); }
+
+/* 许可微标：MIT / Apache-2.0 这类代码用等宽；未知用 caution 色标出来，
+   空值本身是结论，不是缺陷。 */
+.vl-license {
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-license.is-code {
+  font-family: var(--vl-mono);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  letter-spacing: 0.02em;
+}
+
+.vl-license.is-unknown { color: var(--vl-caution); }
+
+/* 核验于：绿色方点全站只表示「已核验」这一件事 */
+.vl-checked {
+  display: inline-flex;
+  align-items: baseline;
+  gap: var(--vl-s2);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+
+.vl-checked-dot {
+  flex: none;
+  align-self: center;
+  width: 5px;
+  height: 5px;
+  background: var(--vl-verify);
+}
+
+.vl-checked time { color: var(--vl-ink-2); }
+
+/* 网格卡（全部站点）：整卡是一个拉伸链接，右下角另有「去源站」，两个出口都画出来 */
+.vl-card--grid {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s3);
+  padding: var(--vl-s4);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+}
+
+.vl-card--grid:hover {
+  border-color: var(--vl-line-strong);
+  box-shadow: var(--vl-shadow-1);
+}
+
+.vl-card--grid .vl-card-name { font-size: var(--vl-fs-lg); line-height: var(--vl-lh-lg); }
+
+.vl-card-link { color: inherit; }
+
+.vl-card-link::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: var(--vl-r-sm);
+}
+
+.vl-card-link:hover { text-decoration: underline; text-underline-offset: 3px; }
+
+.vl-card-foot {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s3);
+  margin-top: auto;
+  padding-top: var(--vl-s3);
+  border-top: 1px solid var(--vl-line);
+}
+
+.vl-card-source {
+  position: relative;
+  z-index: 1;
+  margin-left: auto;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+  border-bottom: 1px solid var(--vl-line-strong);
+  padding-bottom: 1px;
+}
+
+.vl-card-source:hover { color: var(--vl-ink); border-bottom-color: var(--vl-accent); }
+
+/* ---------------------------------------------------------------
+   5. 全部站点入口（首页折叠线以下）
+   --------------------------------------------------------------- */
+
+.vl-allsites-entry {
+  margin-top: var(--vl-s8);
+  padding-top: var(--vl-s6);
+  border-top: 1px solid var(--vl-line);
+}
+
+.vl-allsites-link {
+  display: inline-block;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xl);
+  line-height: var(--vl-lh-xl);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -0.01em;
+}
+
+.vl-allsites-link:hover { text-decoration: underline; text-underline-offset: 4px; }
+
+.vl-allsites-note {
+  margin: var(--vl-s2) 0 0;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+/* ---------------------------------------------------------------
+   6. 全部站点页
+   --------------------------------------------------------------- */
+
+.vl-page-head { padding-block: var(--vl-s6) var(--vl-s5); }
+
+.vl-back {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-back:hover { color: var(--vl-ink); }
+
+.vl-page-title {
+  margin: var(--vl-s2) 0 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-2xl);
+  line-height: var(--vl-lh-2xl);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -0.01em;
+}
+
+.vl-page-meta {
+  margin: var(--vl-s2) 0 0;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+.vl-tools {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--vl-s3);
+  margin-bottom: var(--vl-s4);
+}
+
+.vl-search { flex: 1 1 260px; min-width: 0; }
+
+.vl-search input {
+  width: 100%;
+  height: var(--vl-s8);
+  padding: 0 var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+.vl-search input::placeholder { color: var(--vl-ink-3); }
+.vl-search input:focus { border-color: var(--vl-accent); }
+
+.vl-sort {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-sort select {
+  height: var(--vl-s8);
+  padding: 0 var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+/* chips */
+.vl-chips-toggle {
+  display: inline-flex;
+  align-items: center;
+  min-height: 34px;
+  padding: 0 var(--vl-s4);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-chips-groups {
+  display: none;
+  gap: var(--vl-s3);
+  margin-top: var(--vl-s3);
+  padding: var(--vl-s4);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+}
+
+.vl-chips.is-open .vl-chips-groups { display: grid; }
+
+.vl-chips-row {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--vl-s2);
+}
+
+.vl-chips-row + .vl-chips-row {
+  padding-top: var(--vl-s3);
+  border-top: 1px solid var(--vl-line);
+}
+
+.vl-chips-label {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+
+.vl-chips-values {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--vl-s2);
+}
+
+.vl-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  min-height: 34px;
+  padding: 0 var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+  transition: border-color var(--vl-dur-1) var(--vl-ease-out),
+              background-color var(--vl-dur-1) var(--vl-ease-out);
+}
+
+.vl-chip:hover { border-color: var(--vl-ink-3); color: var(--vl-ink); }
+
+.vl-chip.is-on {
+  background: var(--vl-accent);
+  border-color: var(--vl-accent);
+  color: var(--vl-accent-ink);
+}
+
+.vl-chip-count {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  font-variant-numeric: tabular-nums;
+}
+
+.vl-chip.is-on .vl-chip-count { color: var(--vl-accent-ink); opacity: .72; }
+
+.vl-chips-clear {
+  justify-self: start;
+  padding: var(--vl-s1) 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+  border-bottom: 1px solid var(--vl-line-strong);
+}
+
+.vl-chips-clear:hover { color: var(--vl-ink); border-bottom-color: var(--vl-accent); }
+
+.vl-result-count {
+  margin: var(--vl-s5) 0 var(--vl-s3);
+  min-height: var(--vl-s5);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  font-variant-numeric: tabular-nums;
+}
+
+.vl-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  align-items: start;
+  gap: var(--vl-s4);
+}
+
+/* 空结果：说清哪个条件排除得最多，并给一个能立刻按的出口 */
+.vl-empty {
+  padding: var(--vl-s7) var(--vl-s5);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+}
+
+.vl-empty h2 {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-lg);
+  line-height: var(--vl-lh-lg);
+  font-weight: var(--vl-fw-bold);
+}
+
+.vl-empty p {
+  margin: var(--vl-s3) 0 0;
+  max-width: 56ch;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+.vl-empty b { color: var(--vl-ink); font-weight: var(--vl-fw-medium); }
+
+.vl-empty-action {
+  margin-top: var(--vl-s4);
+  min-height: 34px;
+  padding: 0 var(--vl-s4);
+  border: 1px solid var(--vl-accent);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+.vl-empty-note { color: var(--vl-ink-3); }
+
+.vl-empty-note a {
+  color: var(--vl-ink-2);
+  border-bottom: 1px solid var(--vl-line-strong);
+}
+
+.vl-empty-note a:hover { color: var(--vl-ink); border-bottom-color: var(--vl-accent); }
+
+/* ---------------------------------------------------------------
+   7. 骨架：灰块，无流光
+   --------------------------------------------------------------- */
+
+.vl-skel {
+  display: block;
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+}
+
+.vl-skel-title { width: min(100%, 420px); height: var(--vl-s6); }
+.vl-skel-shot { width: 100%; aspect-ratio: 16 / 10; }
+.vl-skel-line { width: 100%; height: var(--vl-s3); }
+.vl-skel-line.is-short { width: 60%; }
+
+.vl-group-head .vl-skel + .vl-skel { margin-top: var(--vl-s3); }
+
+.vl-card--skeleton {
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s3);
+  min-width: 0;
+  padding: var(--vl-s3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+}
+
+/* ---------------------------------------------------------------
+   8. ≥768：卡片墙加到两列
+   --------------------------------------------------------------- */
+
+@media (min-width: 768px) {
+  .vl-promise { padding-block: var(--vl-s8) var(--vl-s7); }
+  .vl-promise-title { font-size: var(--vl-fs-3xl); line-height: var(--vl-lh-3xl); }
+  .vl-promise-line { font-size: var(--vl-fs-md); line-height: var(--vl-lh-md); }
+
+  .vl-group-title { font-size: var(--vl-fs-2xl); line-height: var(--vl-lh-2xl); }
+  .vl-group-blurb { font-size: var(--vl-fs-sm); line-height: var(--vl-lh-sm); }
+
+  .vl-group-grid,
+  .vl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--vl-s5); }
+
+  .vl-chips-toggle { display: none; }
+  .vl-chips-groups { display: grid; }
+
+  .vl-chips-row {
+    grid-template-columns: 5.5em minmax(0, 1fr);
+    align-items: baseline;
+    gap: var(--vl-s4);
+  }
+
+  .vl-page-title { font-size: var(--vl-fs-3xl); line-height: var(--vl-lh-3xl); }
+}
+
+/* ---------------------------------------------------------------
+   9. ≥1280：桌面
+   --------------------------------------------------------------- */
+
+@media (min-width: 1280px) {
+  .vl-promise-title { font-size: var(--vl-fs-4xl); line-height: var(--vl-lh-4xl); }
+
+  .vl-group-grid,
+  .vl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
diff --git a/frontend/src/styles/shell.css b/frontend/src/styles/shell.css
new file mode 100644
index 0000000..43c008d
--- /dev/null
+++ b/frontend/src/styles/shell.css
@@ -0,0 +1,675 @@
+/* ============================================================
+   外壳层：站点容器、跳转链接、顶栏 / 汉堡 / 移动端菜单、路由容器、
+   通用按钮、页脚、⌘K 命令面板与 Spec 抽屉。
+   规则从 App.css 机械搬运，选择器名不变；颜色/字号/圆角/阴影已换 token。
+   WP-C 会在这里补顶栏三频道、主题切换、全站搜索与页脚查重框。
+   ============================================================ */
+
+.site {
+  min-height: 100vh;
+  background: var(--vl-bg);
+}
+
+/* ---- 跳转到主要内容 ---- */
+.skip-link {
+  position: fixed;
+  left: var(--vl-gutter);
+  top: var(--vl-s2);
+  z-index: 100;
+  translate: 0 -160%;
+  padding: var(--vl-s2) var(--vl-s3);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  font-size: var(--vl-fs-2xs);
+}
+.skip-link:focus { translate: 0 0; }
+
+/* ============ 顶栏 ============
+   实底 + backdrop-filter 兜底底色（方案 §7.4 第 8 条：不再 transparent，
+   卡片内容不会从 logo 底下穿过去）。 */
+.nav {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 100;
+  width: auto;
+  height: var(--vl-header-h);
+  margin: 0;
+  padding: 0 var(--vl-gutter);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0;
+  background: var(--vl-bg);
+  border: 0;
+  border-bottom: 1px solid var(--vl-line);
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+}
+
+.nav-left {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s7);
+  flex-shrink: 0;
+}
+
+.nav-brand {
+  display: block;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-md);
+  font-weight: var(--vl-fw-bold);
+  white-space: nowrap;
+}
+
+.nav-links {
+  display: none;
+  align-items: center;
+  gap: var(--vl-s6);
+}
+
+.nav-link {
+  display: flex;
+  align-items: center;
+  min-height: 44px;   /* 命中区 ≥44 高，视觉高度不变（padding 不可见） */
+  margin: 0;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-regular);
+  white-space: nowrap;
+  transition: color var(--vl-dur-1) var(--vl-ease-out);
+}
+.nav-link:hover { color: var(--vl-ink-2); }
+.nav-link.on { color: var(--vl-ink); font-weight: var(--vl-fw-bold); }
+
+/* 汉堡：手机上出现，≥768 收起 */
+.nav-hamburger {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  margin: 0;
+  padding: var(--vl-s2);
+  gap: 5px;
+  border: 0;
+  background: transparent;
+}
+.nav-hamburger span {
+  display: block;
+  width: 20px;
+  height: 1.5px;
+  flex: none;
+  background: var(--vl-ink);
+  transform-origin: center;
+  transition: transform var(--vl-dur-2) var(--vl-ease-out), opacity var(--vl-dur-2) var(--vl-ease-out);
+}
+.nav-hamburger.open span:first-child { transform: rotate(45deg) translate(2px, 2px); }
+.nav-hamburger.open span:last-child { transform: rotate(-45deg) translate(2px, -2px); }
+
+.mobile-menu {
+  position: absolute;
+  top: var(--vl-header-h);
+  left: 0;
+  right: 0;
+  display: flex;
+  flex-direction: column;
+  padding: var(--vl-s3) var(--vl-gutter) var(--vl-s5);
+  background: var(--vl-bg);
+  border-bottom: 1px solid var(--vl-line);
+  box-shadow: var(--vl-shadow-2);
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+}
+.mobile-nav-link {
+  display: block;
+  width: 100%;
+  padding: var(--vl-s3) 0;
+  border: 0;
+  border-bottom: 1px solid var(--vl-line);
+  border-radius: 0;
+  background: transparent;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-md);
+  font-weight: var(--vl-fw-regular);
+}
+.mobile-nav-link:last-child { border-bottom: 0; }
+.mobile-nav-link.on { font-weight: var(--vl-fw-bold); }
+
+/* 关闭态用 hidden 属性而不是条件渲染；作者的 display:flex 会盖过 UA 的
+   [hidden]{display:none}，所以这里显式写回去（方案 §7.4 第 2 条）。 */
+.mobile-menu[hidden] { display: none; }
+
+/* ---- 路由容器 ---- */
+.route {
+  padding-top: var(--vl-header-h);
+  animation: viewIn var(--vl-dur-3) var(--vl-ease-out) both;
+}
+.route:focus { outline: none; }
+
+@keyframes viewIn {
+  from { opacity: 0; transform: translateY(10px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* 图鉴是定高工作台，不参与路由淡入 */
+.site[data-view='atlas'] {
+  height: 100vh;
+  overflow: hidden;
+}
+.site[data-view='atlas'] .route {
+  height: 100vh;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  animation: none;
+  opacity: 1;
+  transform: none;
+}
+
+
+/* ============ 通用按钮 ============ */
+.btn-primary {
+  padding: 9px var(--vl-s4);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  font-weight: var(--vl-fw-medium);
+  font-size: var(--vl-fs-sm);
+  transition: filter var(--vl-dur-1), transform var(--vl-dur-1);
+}
+.btn-primary:hover { filter: brightness(1.12); }
+.btn-primary:active { transform: translateY(1px); }
+.btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
+
+.btn-ghost {
+  display: inline-flex;
+  align-items: center;
+  padding: 9px var(--vl-s4);
+  border-radius: var(--vl-r-sm);
+  border: 1px solid var(--vl-line);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  transition: var(--vl-dur-1);
+}
+.btn-ghost:hover { border-color: var(--vl-line-strong); color: var(--vl-ink); }
+.btn-ghost:disabled { opacity: 0.35; cursor: not-allowed; }
+
+.copy-btn {
+  padding: 5px var(--vl-s3);
+  border-radius: var(--vl-r-sm);
+  border: 1px solid var(--vl-line);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-2xs);
+  white-space: nowrap;
+  transition: var(--vl-dur-1);
+}
+.copy-btn:hover { border-color: var(--vl-line-strong); color: var(--vl-ink); }
+
+.inline-link {
+  color: var(--vl-ink);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  text-decoration-color: var(--vl-line-strong);
+}
+.inline-link:hover { text-decoration-color: var(--vl-ink); }
+
+/* ============ 顶栏右区：搜索 + 主题 + 汉堡 ============ */
+.nav-right {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  min-width: 0;
+}
+
+/* ---- 全站搜索 ---- */
+.gs { position: relative; display: flex; align-items: center; }
+
+.gs-toggle {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  color: var(--vl-ink-2);
+  border-radius: var(--vl-r-sm);
+}
+.gs-toggle:hover { color: var(--vl-ink); }
+
+/* 手机：搜索框默认收起，点 ⌕ 后铺满顶栏下方一整行 */
+.gs-field { display: none; }
+.gs.open .gs-field {
+  position: fixed;
+  top: var(--vl-header-h);
+  left: 0;
+  right: 0;
+  z-index: 101;
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  padding: var(--vl-s2) var(--vl-gutter);
+  background: var(--vl-bg);
+  border-bottom: 1px solid var(--vl-line);
+}
+.gs-icon { display: flex; color: var(--vl-ink-3); }
+.gs-input {
+  flex: 1;
+  min-width: 0;
+  height: 36px;
+  padding: 0 var(--vl-s2);
+  border: 0;
+  background: transparent;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  outline: 0;
+}
+.gs-input::placeholder { color: var(--vl-ink-3); }
+.gs-kbd {
+  display: none;
+  color: var(--vl-ink-3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-xs);
+  padding: 2px var(--vl-s2);
+}
+
+.gs-list {
+  position: fixed;
+  top: calc(var(--vl-header-h) + 52px);
+  left: 0;
+  right: 0;
+  z-index: 101;
+  max-height: 60vh;
+  overflow-y: auto;
+  padding: var(--vl-s2) 0;
+  background: var(--vl-surface);
+  border-top: 1px solid var(--vl-line);
+  border-bottom: 1px solid var(--vl-line);
+  box-shadow: var(--vl-shadow-2);
+}
+.gs-list[hidden] { display: none; }
+
+.gs-group + .gs-group { border-top: 1px solid var(--vl-line); margin-top: var(--vl-s2); padding-top: var(--vl-s2); }
+.gs-group-h {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  margin: 0;
+  padding: var(--vl-s2) var(--vl-s4);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+.gs-group-h em { font-style: normal; }
+
+.gs-opt {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: baseline;
+  gap: var(--vl-s1) var(--vl-s3);
+  padding: var(--vl-s2) var(--vl-s4);
+  min-height: 44px;
+  align-content: center;
+}
+.gs-opt.on { background: var(--vl-accent-wash); }
+.gs-opt b { color: var(--vl-ink); font-size: var(--vl-fs-sm); font-weight: var(--vl-fw-medium); }
+.gs-opt code { color: var(--vl-ink-3); justify-self: end; }
+.gs-opt em {
+  grid-column: 1 / -1;
+  color: var(--vl-ink-3);
+  font-style: normal;
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.gs-opt-all { grid-column: 1 / -1; color: var(--vl-ink-2); font-size: var(--vl-fs-xs); }
+.gs-note { margin: 0; padding: var(--vl-s4); color: var(--vl-ink-3); font-size: var(--vl-fs-xs); }
+
+/* ---- 主题三态 ---- */
+.theme-toggle {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  padding: 2px;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-pill);
+}
+.theme-opt {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border-radius: var(--vl-r-pill);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: 1;
+}
+.theme-opt:hover { color: var(--vl-ink-2); }
+.theme-opt.on { background: var(--vl-accent); color: var(--vl-accent-ink); }
+
+/* ============ 主体与路由容器 ============ */
+.site-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
+.route-loading,
+.route-placeholder {
+  width: var(--vl-container);
+  margin: 0 auto;
+  padding: var(--vl-s10) 0;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-sm);
+}
+
+/* ============ 404 ============ */
+.notfound {
+  width: var(--vl-container);
+  margin: 0 auto;
+  padding: var(--vl-s10) 0;
+}
+.notfound > * { max-width: 62ch; }
+.notfound > p:first-child { color: var(--vl-ink-3); margin: 0 0 var(--vl-s3); }
+.notfound h1 {
+  margin: 0 0 var(--vl-s4);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-2xl);
+  line-height: var(--vl-lh-2xl);
+  font-weight: var(--vl-fw-bold);
+}
+.notfound p { color: var(--vl-ink-2); font-size: var(--vl-fs-sm); line-height: var(--vl-lh-sm); }
+.notfound-links { display: flex; flex-wrap: wrap; gap: var(--vl-s3); margin-top: var(--vl-s6); }
+
+/* ============ 页脚 ============ */
+.site-foot {
+  margin-top: var(--vl-s10);
+  border-top: 1px solid var(--vl-line);
+  background: var(--vl-surface);
+}
+.site-foot-in {
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s6);
+  width: var(--vl-container);
+  margin: 0 auto;
+  padding: var(--vl-s7) 0 var(--vl-s9);
+}
+.site-foot-nav { display: flex; flex-wrap: wrap; gap: var(--vl-s5); font-size: var(--vl-fs-xs); }
+
+/* ---- 页脚查重框 ---- */
+.subcheck { max-width: 62ch; }
+.subcheck-label {
+  display: block;
+  margin-bottom: var(--vl-s2);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  font-weight: var(--vl-fw-medium);
+}
+.subcheck-row { display: flex; gap: var(--vl-s2); flex-wrap: wrap; }
+.subcheck-input {
+  flex: 1;
+  min-width: 200px;
+  height: 40px;
+  padding: 0 var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+}
+.subcheck-out:empty { display: none; }
+.subcheck-msg {
+  margin: var(--vl-s3) 0 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+.subcheck-msg strong { color: var(--vl-ink); font-weight: var(--vl-fw-medium); }
+.subcheck-json {
+  contain: paint;
+  margin: var(--vl-s3) 0 0;
+  padding: var(--vl-s3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+  overflow-x: auto;
+}
+.subcheck-json code { color: var(--vl-ink-2); white-space: pre; }
+.subcheck-actions { display: flex; align-items: center; gap: var(--vl-s3); flex-wrap: wrap; margin-top: var(--vl-s3); }
+.subcheck-ok { color: var(--vl-verify); font-size: var(--vl-fs-2xs); }
+.subcheck-fail { color: var(--vl-danger); font-size: var(--vl-fs-2xs); }
+.subcheck-note { margin: var(--vl-s3) 0 0; color: var(--vl-ink-3); font-size: var(--vl-fs-2xs); }
+
+/* ============ 关于页 ============ */
+.about {
+  width: var(--vl-container);
+  margin: 0 auto;
+  padding: var(--vl-s8) 0 var(--vl-s9);
+}
+.ab-head { max-width: 62ch; }
+.ab-head h1 {
+  margin: 0 0 var(--vl-s4);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-3xl);
+  line-height: var(--vl-lh-3xl);
+  font-weight: var(--vl-fw-bold);
+}
+.ab-lede { margin: 0; color: var(--vl-ink-2); font-size: var(--vl-fs-md); line-height: var(--vl-lh-md); }
+.ab-warn {
+  margin: var(--vl-s4) 0 0;
+  padding: var(--vl-s2) var(--vl-s3);
+  border: 1px solid var(--vl-caution);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-caution-wash);
+  color: var(--vl-caution);
+  font-size: var(--vl-fs-xs);
+}
+
+.ab-sec { margin-top: var(--vl-s9); scroll-margin-top: calc(var(--vl-header-h) + var(--vl-s4)); }
+.ab-sec h2 {
+  margin: 0 0 var(--vl-s4);
+  padding-bottom: var(--vl-s2);
+  border-bottom: 1px solid var(--vl-line);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xl);
+  line-height: var(--vl-lh-xl);
+  font-weight: var(--vl-fw-bold);
+}
+.ab-sec h3 {
+  margin: var(--vl-s6) 0 var(--vl-s2);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-md);
+  font-weight: var(--vl-fw-medium);
+}
+.ab-sec p {
+  max-width: 62ch;
+  margin: 0 0 var(--vl-s3);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+.ab-sec code { color: var(--vl-ink-2); }
+
+.ab-dl { max-width: 62ch; margin: 0 0 var(--vl-s3); }
+.ab-dl dt { color: var(--vl-ink); font-size: var(--vl-fs-sm); font-weight: var(--vl-fw-medium); margin-top: var(--vl-s3); }
+.ab-dl dd { margin: var(--vl-s1) 0 0; color: var(--vl-ink-2); font-size: var(--vl-fs-sm); line-height: var(--vl-lh-sm); }
+
+.ab-list { max-width: 62ch; margin: 0 0 var(--vl-s3); padding-left: var(--vl-s5); }
+.ab-list li { color: var(--vl-ink-2); font-size: var(--vl-fs-sm); line-height: var(--vl-lh-sm); margin-bottom: var(--vl-s2); }
+
+.ab-table-wrap {
+  overflow-x: auto;
+  margin: var(--vl-s4) 0;
+  /* contain 让这个滚动容器的内容不再计进 body.scrollWidth：
+     base.css 给 body 的是 overflow-x: clip，clip 不建立滚动上下文，
+     没有 contain 时整页会被这张宽表撑成 652px（实测）。 */
+  contain: paint;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+}
+.ab-table {
+  width: 100%;
+  min-width: 640px;
+  border-collapse: collapse;
+  font-size: var(--vl-fs-xs);
+}
+.ab-table th,
+.ab-table td {
+  padding: var(--vl-s3);
+  border-bottom: 1px solid var(--vl-line);
+  text-align: left;
+  vertical-align: top;
+  line-height: var(--vl-lh-xs);
+}
+.ab-table thead th {
+  color: var(--vl-ink-3);
+  font-weight: var(--vl-fw-regular);
+  border-bottom: 1px solid var(--vl-line-strong);
+  white-space: nowrap;
+}
+.ab-table tbody th { color: var(--vl-ink); font-weight: var(--vl-fw-medium); }
+.ab-table td { color: var(--vl-ink-2); }
+.ab-method { color: var(--vl-ink-3); }
+.ab-value { white-space: nowrap; text-align: right; }
+
+.ab-num {
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  font-weight: var(--vl-fw-medium);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  text-decoration-color: var(--vl-line-strong);
+}
+a.ab-num:hover { text-decoration-color: var(--vl-ink); }
+.ab-num.none { color: var(--vl-ink-3); font-size: var(--vl-fs-sm); text-decoration: none; }
+.ab-foot-note { color: var(--vl-ink-3); font-size: var(--vl-fs-2xs); line-height: var(--vl-lh-2xs); }
+
+.ab-endpoints { list-style: none; margin: var(--vl-s4) 0; padding: 0; }
+.ab-endpoint {
+  padding: var(--vl-s4);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+  background: var(--vl-surface);
+}
+.ab-endpoint + .ab-endpoint { margin-top: var(--vl-s3); }
+.ab-endpoint-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--vl-s3); }
+.ab-probe { font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); }
+.ab-probe.ok { color: var(--vl-verify); }
+.ab-probe.missing { color: var(--vl-danger); }
+.ab-endpoint-t { margin: var(--vl-s2) 0 0 !important; color: var(--vl-ink) !important; font-weight: var(--vl-fw-medium); }
+.ab-endpoint-d { margin: var(--vl-s1) 0 0 !important; }
+
+.ab-removed { max-width: 62ch; margin: var(--vl-s4) 0 0; padding-left: var(--vl-s5); }
+.ab-removed li { margin-bottom: var(--vl-s5); }
+.ab-removed h3 { margin: 0 0 var(--vl-s1); }
+.ab-removed p { margin: 0; }
+
+/* ---- ΔE 演示 ---- */
+.de {
+  margin: var(--vl-s6) 0 0;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+  background: var(--vl-surface);
+}
+.de-sum {
+  padding: var(--vl-s3) var(--vl-s4);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  font-weight: var(--vl-fw-medium);
+  cursor: pointer;
+  min-height: 44px;
+  display: flex;
+  align-items: center;
+}
+.de-body { padding: 0 var(--vl-s4) var(--vl-s4); }
+.de-pickers { display: flex; flex-wrap: wrap; gap: var(--vl-s3); align-items: flex-end; margin-bottom: var(--vl-s4); }
+.de-pick { display: flex; flex-direction: column; gap: var(--vl-s1); font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); }
+.de-pick select {
+  min-height: 36px;
+  padding: 0 var(--vl-s2);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xs);
+}
+.de-shots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--vl-s3); }
+.de-shot { margin: 0; }
+.de-shot img {
+  width: 100%;
+  height: auto;
+  display: block;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+}
+.de-shot figcaption { margin-top: var(--vl-s1); color: var(--vl-ink-3); }
+.de-out { margin-top: var(--vl-s4); }
+.de-metrics { display: flex; flex-wrap: wrap; gap: var(--vl-s5); margin: 0 0 var(--vl-s4); }
+.de-metrics dt { color: var(--vl-ink-3); font-size: var(--vl-fs-2xs); }
+.de-metrics dd { margin: 0; color: var(--vl-ink); font-size: var(--vl-fs-lg); font-weight: var(--vl-fw-medium); }
+.de-grid {
+  display: grid;
+  gap: 1px;
+  max-width: 320px;
+  aspect-ratio: 1;
+  background: var(--vl-surface-sunk);
+}
+.de-grid i { background: var(--vl-accent); display: block; }
+.de-note { color: var(--vl-ink-3) !important; font-size: var(--vl-fs-2xs) !important; line-height: var(--vl-lh-2xs) !important; }
+
+/* ============ 768 以上 ============ */
+@media (min-width: 768px) {
+  .nav-links { display: flex; }
+  .nav-hamburger,
+  .mobile-menu,
+  .gs-toggle { display: none; }
+
+  .gs-field,
+  .gs.open .gs-field {
+    position: static;
+    display: flex;
+    align-items: center;
+    gap: var(--vl-s2);
+    width: 260px;
+    padding: 0 var(--vl-s3);
+    border: 1px solid var(--vl-line);
+    border-bottom: 1px solid var(--vl-line);
+    border-radius: var(--vl-r-pill);
+    background: var(--vl-surface-sunk);
+  }
+  .gs-kbd { display: inline-block; }
+  .gs-list {
+    position: absolute;
+    top: calc(100% + var(--vl-s2));
+    left: auto;
+    right: 0;
+    width: 420px;
+    max-height: 420px;
+    border: 1px solid var(--vl-line);
+    border-radius: var(--vl-r-md);
+  }
+
+  .site-foot-in { flex-direction: row; justify-content: space-between; align-items: flex-start; }
+  .site-foot-nav { flex-direction: column; gap: var(--vl-s3); }
+  .subcheck { flex: 1; max-width: 62ch; }
+
+  .de-shots { grid-template-columns: 1fr 1fr; max-width: 520px; }
+}
+
+@media (min-width: 1280px) {
+  .nav-left { gap: var(--vl-s8); }
+  .nav-links { gap: var(--vl-s7); }
+  .gs-field, .gs.open .gs-field { width: 320px; }
+}
diff --git a/frontend/src/styles/site-detail.css b/frontend/src/styles/site-detail.css
new file mode 100644
index 0000000..61d019b
--- /dev/null
+++ b/frontend/src/styles/site-detail.css
@@ -0,0 +1,698 @@
+/* ============================================================
+   站点详情（WP-E）：`#/site/<entryId>` 的路由页。
+   一份结构两种形态——手机是底部抽屉，≥768px 是浮窗，只靠 CSS 切换。
+   本文件只用 tokens.css 的 --vl-*，不写任何颜色/字号字面量。
+   ============================================================ */
+
+/* ---- 遮罩层：手机贴底，桌面居中 ---- */
+.sd-layer {
+  position: fixed;
+  inset: 0;
+  z-index: 120;
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  background: var(--vl-scrim);
+  animation: sd-fade var(--vl-dur-2) var(--vl-ease-out) both;
+}
+
+.sd-panel {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  max-height: 92vh;
+  max-height: 92dvh;
+  background: var(--vl-surface);
+  border-top: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-lg) var(--vl-r-lg) 0 0;
+  box-shadow: var(--vl-shadow-3);
+  outline: none;
+  animation: sd-rise var(--vl-dur-2) var(--vl-ease-emph) both;
+}
+
+@keyframes sd-fade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes sd-rise { from { transform: translateY(2%); } to { transform: none; } }
+@keyframes sd-pop { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: none; } }
+@keyframes sd-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
+
+/* 顶栏：实底，抽屉的抓手与关闭键都在这里。
+   它是 flex 项不是浮层，所以滚动内容从它下面切过去，不会被压住。 */
+.sd-bar {
+  position: relative;
+  flex: none;
+  display: flex;
+  justify-content: flex-end;
+  padding: var(--vl-s2) var(--vl-s3);
+  background: var(--vl-surface);
+  border-radius: var(--vl-r-lg) var(--vl-r-lg) 0 0;
+}
+
+/* 抓手：只在抽屉形态出现 */
+.sd-grab {
+  position: absolute;
+  top: var(--vl-s2);
+  left: 50%;
+  width: 36px;
+  height: 4px;
+  margin-left: -18px;
+  border-radius: var(--vl-r-pill);
+  background: var(--vl-line-strong);
+}
+
+.sd-close {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-pill);
+  background: var(--vl-surface);
+  color: var(--vl-ink);
+  transition: background var(--vl-dur-1) var(--vl-ease-out);
+}
+.sd-close:hover { background: var(--vl-surface-sunk); }
+
+/* ---- 滚动区 ---- */
+.sd-scroll {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  overflow-x: hidden;
+  overscroll-behavior: contain;
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s5);
+  padding: 0 var(--vl-s5) var(--vl-s6);
+}
+
+.sd-scroll > .sd-section,
+.sd-scroll > .sd-archive {
+  border-top: 1px solid var(--vl-line);
+  padding-top: var(--vl-s5);
+}
+
+.sd-section {
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s3);
+}
+
+.sd-h {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: .04em;
+}
+
+/* ---- ① 通往源站的大链接（页面第一个元素） ---- */
+.sd-source {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s3);
+  border-radius: var(--vl-r-md);
+  text-decoration: none;
+}
+.sd-source-text {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+.sd-name {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xl);
+  line-height: var(--vl-lh-xl);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -.02em;
+  overflow-wrap: anywhere;
+}
+.sd-source:hover .sd-name { text-decoration: underline; text-underline-offset: 3px; }
+.sd-domain {
+  display: block;
+  color: var(--vl-ink-3);
+  overflow-wrap: anywhere;
+}
+
+/* 作用域限定在浮窗内：WP-D 的卡片给同名 class 另有一套（整张占位图）规则，
+   两边形态不同，集成时再统一。 */
+.sd-panel .vl-domain-mark {
+  flex: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  border-radius: var(--vl-r-md);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  font-size: var(--vl-fs-lg);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -.02em;
+}
+
+/* 核验时间：全站唯一用深绿的地方（方案 §7.1） */
+.sd-checked {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  margin: 0;
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+.sd-checked-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: var(--vl-r-pill);
+  background: var(--vl-verify);
+}
+
+/* ---- ② 一句编辑判断 + 编辑手记 ----
+   这一段是整页真正给人读的地方：一句标题级的判断，下面是手记正文。
+   两者之间留出一整格空气，别让它们黏成一坨。 */
+.sd-voice { gap: var(--vl-s4); }
+
+.sd-takeaway {
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xl);
+  line-height: var(--vl-lh-xl);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: -.01em;
+  text-wrap: balance;
+}
+
+/* 正文字号、行高 1.7、最大行宽约 34em：按连续阅读排，不按字段排。 */
+.sd-note {
+  max-width: 34em;
+  margin: 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-md);
+  line-height: 1.7;
+}
+/* 手记还没写：虚线框如实说，不拿正式简介顶替。 */
+.sd-note-empty {
+  padding: var(--vl-s3) var(--vl-s4);
+  border: 1px dashed var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  color: var(--vl-caution);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+/* 档案区里的正式简介：书面那一份，按正文排但比手记克制 */
+.sd-fact-desc {
+  margin: 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  overflow-wrap: anywhere;
+}
+
+/* ---- ③ 三张证据图 ---- */
+.sd-ev-row {
+  display: grid;
+  grid-auto-flow: column;
+  grid-auto-columns: 82%;
+  gap: var(--vl-s3);
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  padding-bottom: var(--vl-s2);
+}
+/* 四行栅格（角色 / 图 / 一句话 / 看原页）：说明文字长短不一时，
+   三张图的「看原页」仍然落在同一条基线上。 */
+.sd-ev {
+  display: grid;
+  grid-template-rows: auto auto 1fr auto;
+  justify-items: start;
+  gap: var(--vl-s2);
+  margin: 0;
+  min-width: 0;
+  scroll-snap-align: start;
+}
+.sd-ev-role {
+  padding: 2px var(--vl-s2);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-xs);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  font-weight: var(--vl-fw-medium);
+  letter-spacing: .08em;
+}
+.sd-ev-frame {
+  width: 100%;
+  aspect-ratio: 1280 / 900;
+  overflow: hidden;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+  background: var(--vl-surface-sunk);
+}
+.sd-ev-frame img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: top center;
+}
+.sd-ev-empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: var(--vl-s2);
+  height: 100%;
+  padding: var(--vl-s4);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  text-align: center;
+}
+.sd-ev-why {
+  margin: 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+.sd-ev-link {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--vl-s1);
+  min-height: 28px;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xs);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+/* ---- ④ 你能拿走什么 · 权利边界 ---- */
+.sd-take {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-md);
+  line-height: var(--vl-lh-md);
+}
+.sd-take-sep { color: var(--vl-ink-3); }
+.sd-take-how { color: var(--vl-ink-2); }
+
+.sd-rights,
+.sd-facts,
+.sd-facet-list {
+  display: grid;
+  gap: var(--vl-s3);
+  margin: 0;
+}
+.sd-rights > div,
+.sd-fact,
+.sd-facet-axis {
+  display: grid;
+  grid-template-columns: 5.5em minmax(0, 1fr);
+  gap: var(--vl-s3);
+  align-items: baseline;
+}
+.sd-rights dt,
+.sd-fact-field,
+.sd-facet-axis dt {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+.sd-rights dd {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  overflow-wrap: anywhere;
+}
+
+/* 来源角标（L4 / L5）：小、不抢戏，但每条判断旁边都必须有一个。
+   手机上给到 32px 命中高度（手指），桌面收回 26px（指针）——
+   离 44×44 的目标值仍有距离：每条事实旁都放一个 44px 的角标，
+   会把档案区撑成两倍高、把编辑判断挤出屏幕。这里取的是可读性与命中区的折中。 */
+.sd-src {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  min-height: 32px;
+  padding: var(--vl-s1) var(--vl-s2);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-xs);
+  background: var(--vl-surface-sunk);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  white-space: nowrap;
+}
+.sd-src:hover { border-color: var(--vl-line-strong); color: var(--vl-ink); }
+
+/* 未知 / 未写 / 尚未标注：一律显示，用 caution 色标出来，不隐藏 */
+.sd-unknown { color: var(--vl-caution); }
+.sd-empty-note {
+  margin: 0;
+  color: var(--vl-caution);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+.sd-flag {
+  padding: 1px var(--vl-s2);
+  border-radius: var(--vl-r-xs);
+  background: var(--vl-caution-wash);
+  color: var(--vl-caution);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+  font-weight: var(--vl-fw-medium);
+  letter-spacing: 0;
+}
+
+/* ---- ⑤ 这个站示范了哪些术语（L3） ---- */
+.sd-terms {
+  display: grid;
+  gap: var(--vl-s4);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.sd-term {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+}
+.sd-term-link {
+  display: inline-flex;
+  align-items: center;
+  min-height: 28px;
+  padding: 2px var(--vl-s3);
+  border: 1px solid var(--vl-line-strong);
+  border-radius: var(--vl-r-pill);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-medium);
+  transition: background var(--vl-dur-1) var(--vl-ease-out);
+}
+.sd-term-link:hover { background: var(--vl-accent-wash); }
+.sd-term-note {
+  flex: 1 1 100%;
+  margin: 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+}
+
+/* ---- ⑥ 为什么收录它 ---- */
+.sd-reasons {
+  display: grid;
+  gap: var(--vl-s3);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  counter-reset: sd-reason;
+}
+.sd-reasons li {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+}
+.sd-reasons li::before {
+  counter-increment: sd-reason;
+  content: counter(sd-reason);
+  flex: none;
+  width: 20px;
+  color: var(--vl-ink-3);
+  font-family: var(--vl-mono);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-md);
+}
+.sd-reason-text {
+  flex: 1 1 12em;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+
+/* ---- ⑦ 档案：切面标签与字段只活在这里 ---- */
+.sd-archive-summary {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  min-height: 44px;
+  list-style: none;
+  cursor: pointer;
+}
+.sd-archive-summary::-webkit-details-marker { display: none; }
+.sd-archive-summary::after {
+  content: '';
+  width: 8px;
+  height: 8px;
+  margin-left: auto;
+  border-right: 1.5px solid var(--vl-ink-3);
+  border-bottom: 1.5px solid var(--vl-ink-3);
+  transform: rotate(45deg) translate(-2px, -2px);
+  transition: transform var(--vl-dur-1) var(--vl-ease-out);
+}
+.sd-archive[open] .sd-archive-summary::after {
+  transform: rotate(-135deg) translate(-2px, -2px);
+}
+.sd-archive-title {
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: .04em;
+}
+.sd-archive-hint {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+.sd-archive-body {
+  display: grid;
+  gap: var(--vl-s6);
+  padding-top: var(--vl-s3);
+}
+
+.sd-fact-body { min-width: 0; margin: 0; }
+.sd-fact-line {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+  margin: 0;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+.sd-fact-value { overflow-wrap: anywhere; }
+a.sd-fact-value { text-decoration: underline; text-underline-offset: 3px; }
+.sd-fact-evidence {
+  margin: var(--vl-s1) 0 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+  overflow-wrap: anywhere;
+}
+.sd-conf { color: var(--vl-caution); font-size: var(--vl-fs-2xs); }
+
+.sd-sub-title {
+  margin: 0 0 var(--vl-s2);
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-xs);
+  line-height: var(--vl-lh-xs);
+  font-weight: var(--vl-fw-bold);
+  letter-spacing: .04em;
+}
+.sd-facet-axis dd {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--vl-s1);
+  margin: 0;
+}
+.sd-tag {
+  padding: 2px var(--vl-s2);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-xs);
+  background: var(--vl-surface-sunk);
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+
+.sd-agent-links {
+  display: grid;
+  gap: var(--vl-s2);
+  margin: 0 0 var(--vl-s4);
+  padding: 0;
+  list-style: none;
+}
+.sd-agent-links li {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--vl-s2);
+}
+.sd-agent-links a {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--vl-s1);
+  min-height: 28px;
+  color: var(--vl-ink);
+  font-size: var(--vl-fs-sm);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.sd-agent-note { color: var(--vl-ink-3); overflow-wrap: anywhere; }
+.sd-agent-copy {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--vl-s3);
+}
+.sd-copy-status {
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+  line-height: var(--vl-lh-2xs);
+}
+
+/* ---- 按钮 ---- */
+.sd-btn,
+.sd-btn-ghost,
+.sd-visit {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--vl-s1);
+  min-height: 44px;
+  padding: 0 var(--vl-s5);
+  border-radius: var(--vl-r-sm);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+  font-weight: var(--vl-fw-medium);
+  text-decoration: none;
+}
+.sd-btn,
+.sd-visit {
+  border: 1px solid var(--vl-accent);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+}
+.sd-btn-ghost {
+  border: 1px solid var(--vl-line-strong);
+  background: var(--vl-surface);
+  color: var(--vl-ink);
+}
+.sd-btn-ghost:hover { background: var(--vl-surface-sunk); }
+
+/* ---- 底栏：手机常驻，桌面靠右 ---- */
+.sd-foot {
+  flex: none;
+  display: flex;
+  padding: var(--vl-s3) var(--vl-s5);
+  padding-bottom: calc(var(--vl-s3) + env(safe-area-inset-bottom, 0px));
+  border-top: 1px solid var(--vl-line);
+  background: var(--vl-surface);
+}
+.sd-visit { flex: 1 1 auto; }
+
+/* ---- 状态：加载 / 没有这个条目 / 读不到 ---- */
+.sd-state {
+  display: grid;
+  justify-items: start;
+  gap: var(--vl-s4);
+  padding: var(--vl-s5) 0 var(--vl-s6);
+}
+.sd-state p {
+  margin: 0;
+  color: var(--vl-ink-2);
+  font-size: var(--vl-fs-sm);
+  line-height: var(--vl-lh-sm);
+}
+.sd-state-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--vl-s3);
+}
+
+.sd-skeleton {
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s4);
+}
+.sd-sk {
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface-sunk);
+  animation: sd-pulse var(--vl-dur-4) var(--vl-ease-io) infinite;
+}
+.sd-sk-head { width: 60%; height: 28px; }
+.sd-sk-line { width: 100%; height: 14px; }
+.sd-sk-row { display: flex; gap: var(--vl-s3); }
+.sd-sk-shot { flex: 1 1 0; aspect-ratio: 1280 / 900; }
+
+/* ============================================================
+   ≥768px：抽屉变浮窗
+   ============================================================ */
+@media (min-width: 768px) {
+  .sd-layer {
+    align-items: center;
+    padding: var(--vl-s7) var(--vl-s5);
+  }
+  .sd-panel {
+    width: min(880px, 92vw);
+    max-height: 88vh;
+    border: 1px solid var(--vl-line);
+    border-radius: var(--vl-r-lg);
+    animation-name: sd-pop;
+  }
+  .sd-grab { display: none; }
+  .sd-src { min-height: 26px; padding: 2px var(--vl-s2); }
+  .sd-bar { padding: var(--vl-s3) var(--vl-s4) var(--vl-s1); }
+  .sd-scroll {
+    gap: var(--vl-s6);
+    padding: 0 var(--vl-s7) var(--vl-s7);
+  }
+  .sd-scroll > .sd-section,
+  .sd-scroll > .sd-archive { padding-top: var(--vl-s6); }
+  .sd-name {
+    font-size: var(--vl-fs-2xl);
+    line-height: var(--vl-lh-2xl);
+  }
+  /* 桌面上行宽更宽，判断句与手记之间再多给一格 */
+  .sd-voice { gap: var(--vl-s5); }
+  .sd-ev-row {
+    grid-auto-flow: row;
+    grid-auto-columns: auto;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    overflow-x: visible;
+    padding-bottom: 0;
+  }
+  .sd-terms { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--vl-s4) var(--vl-s6); }
+  .sd-foot {
+    justify-content: flex-end;
+    padding: var(--vl-s4) var(--vl-s7);
+  }
+  .sd-visit { flex: 0 0 auto; }
+}
+
+/* reduce-motion：浮窗直接出现，抽屉不滑入（方案 §7.2.7） */
+@media (prefers-reduced-motion: reduce) {
+  .sd-layer,
+  .sd-panel,
+  .sd-sk { animation: none; }
+}
diff --git a/frontend/src/styles/tokens.css b/frontend/src/styles/tokens.css
new file mode 100644
index 0000000..a74d942
--- /dev/null
+++ b/frontend/src/styles/tokens.css
@@ -0,0 +1,215 @@
+/* ============================================================
+   VisLexicon 设计 token（方案 §7.2）
+   全仓唯一允许出现 hex / rgb / hsl 字面量的文件。
+   其它 src/styles/*.css 只能引用这里的 --vl-* 变量。
+   ============================================================ */
+
+/* ---- 断点：只有三条 min-width，全站不得出现第四条 ----------
+   390   设计基准，不写 media query（mobile first）
+   768   @media (min-width: 768px)   平板 / 大手机横屏
+   1280  @media (min-width: 1280px)  桌面
+   1440  @media (min-width: 1440px)  宽桌面（只放宽容器上限，不改结构）
+   ------------------------------------------------------------ */
+
+:root {
+  /* ---- 画布与表面：只有三层 ---- */
+  --vl-bg:            #f6f5f2;
+  --vl-surface:       #ffffff;
+  --vl-surface-sunk:  #efeee9;
+
+  /* ---- 线 ---- */
+  --vl-line:          #e2e0d9;
+  --vl-line-strong:   #cbc8bd;
+
+  /* ---- 文字：三级 ---- */
+  --vl-ink:           #171614;
+  --vl-ink-2:         #504d46;
+  --vl-ink-3:         #6b675e;
+
+  /* ---- 唯一强调色 ---- */
+  --vl-accent:        #171614;
+  --vl-accent-ink:    #ffffff;
+  --vl-accent-wash:   rgba(23, 22, 20, 0.06);
+
+  /* ---- 语义色 ---- */
+  --vl-verify:        #0a6b43;
+  --vl-verify-wash:   rgba(10, 107, 67, 0.10);
+  --vl-caution:       #8a5a00;
+  --vl-caution-wash:  rgba(138, 90, 0, 0.10);
+  --vl-danger:        #a33227;
+  --vl-danger-wash:   rgba(163, 50, 39, 0.10);
+
+  /* ---- 浮层遮罩 ---- */
+  --vl-scrim:         rgba(23, 22, 20, 0.44);
+
+  /* ---- 字体 ---- */
+  --vl-sans: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI',
+             'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC',
+             'Microsoft YaHei', sans-serif;
+  --vl-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Consolas, Menlo, monospace;
+
+  /* ---- 字阶：1.2 Minor Third，全部整数，基础 16px ---- */
+  --vl-fs-2xs: 12px;  --vl-lh-2xs: 1.45;
+  --vl-fs-xs:  13px;  --vl-lh-xs:  1.50;
+  --vl-fs-sm:  14px;  --vl-lh-sm:  1.55;
+  --vl-fs-md:  16px;  --vl-lh-md:  1.60;
+  --vl-fs-lg:  19px;  --vl-lh-lg:  1.45;
+  --vl-fs-xl:  23px;  --vl-lh-xl:  1.35;
+  --vl-fs-2xl: 28px;  --vl-lh-2xl: 1.28;
+  --vl-fs-3xl: 34px;  --vl-lh-3xl: 1.20;
+  --vl-fs-4xl: 41px;  --vl-lh-4xl: 1.12;
+
+  --vl-fw-regular: 400;
+  --vl-fw-medium:  520;
+  --vl-fw-bold:    650;
+
+  /* ---- 间距：4pt 栅格 ---- */
+  --vl-s1:  4px;   --vl-s2:  8px;   --vl-s3: 12px;   --vl-s4: 16px;   --vl-s5: 20px;
+  --vl-s6: 24px;   --vl-s7: 32px;   --vl-s8: 40px;   --vl-s9: 56px;   --vl-s10: 80px;
+
+  /* ---- 圆角 ---- */
+  --vl-r-xs:   4px;
+  --vl-r-sm:   8px;
+  --vl-r-md:  12px;
+  --vl-r-lg:  18px;
+  --vl-r-pill: 999px;
+
+  /* ---- 阴影：只有三档 ---- */
+  --vl-shadow-1: 0 1px 2px rgba(23, 22, 20, .06), 0 1px 1px rgba(23, 22, 20, .04);
+  --vl-shadow-2: 0 4px 12px -2px rgba(23, 22, 20, .08), 0 2px 4px -2px rgba(23, 22, 20, .06);
+  --vl-shadow-3: 0 18px 48px -12px rgba(23, 22, 20, .22), 0 6px 16px -8px rgba(23, 22, 20, .12);
+
+  /* ---- 动效 ---- */
+  --vl-dur-1: 120ms;
+  --vl-dur-2: 200ms;
+  --vl-dur-3: 320ms;
+  --vl-dur-4: 520ms;
+  --vl-ease-out:  cubic-bezier(.2, .8, .3, 1);
+  --vl-ease-io:   cubic-bezier(.4, 0, .2, 1);
+  --vl-ease-emph: cubic-bezier(.32, .72, 0, 1);
+
+  /* ---- 焦点环：两层，先画布色再强调色 ---- */
+  --vl-focus-ring: 0 0 0 2px var(--vl-bg), 0 0 0 4px var(--vl-accent);
+
+  /* ---- 容器 ---- */
+  --vl-container: min(100% - 2 * var(--vl-s6), 1160px);
+
+  /* ---- 外壳几何（顶栏高度与页边，随断点变） ---- */
+  --vl-header-h: 60px;
+  --vl-gutter:   20px;
+
+  color-scheme: light;
+}
+
+/* ---- 深色：跟随系统 ---- */
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) {
+    --vl-bg:            #131210;
+    --vl-surface:       #1c1b18;
+    --vl-surface-sunk:  #24231f;
+    --vl-line:          #302e29;
+    --vl-line-strong:   #423f38;
+    --vl-ink:           #f2f0ea;
+    --vl-ink-2:         #c2beb4;
+    --vl-ink-3:         #948f83;
+    --vl-accent:        #f2f0ea;
+    --vl-accent-ink:    #131210;
+    --vl-accent-wash:   rgba(242, 240, 234, 0.10);
+    --vl-verify:        #4fbb8a;
+    --vl-verify-wash:   rgba(79, 187, 138, 0.14);
+    --vl-caution:       #d9a441;
+    --vl-caution-wash:  rgba(217, 164, 65, 0.14);
+    --vl-danger:        #e0776a;
+    --vl-danger-wash:   rgba(224, 119, 106, 0.14);
+    --vl-scrim:         rgba(0, 0, 0, 0.62);
+    --vl-shadow-1: 0 1px 2px rgba(0, 0, 0, .35);
+    --vl-shadow-2: 0 4px 12px -2px rgba(0, 0, 0, .48), 0 2px 4px -2px rgba(0, 0, 0, .35);
+    --vl-shadow-3: 0 18px 48px -12px rgba(0, 0, 0, .62), 0 6px 16px -8px rgba(0, 0, 0, .48);
+    color-scheme: dark;
+  }
+}
+
+/* ---- 深色：显式选择（ThemeToggle 写 data-theme，由 WP-C 接线） ---- */
+:root[data-theme='dark'] {
+  --vl-bg:            #131210;
+  --vl-surface:       #1c1b18;
+  --vl-surface-sunk:  #24231f;
+  --vl-line:          #302e29;
+  --vl-line-strong:   #423f38;
+  --vl-ink:           #f2f0ea;
+  --vl-ink-2:         #c2beb4;
+  --vl-ink-3:         #948f83;
+  --vl-accent:        #f2f0ea;
+  --vl-accent-ink:    #131210;
+  --vl-accent-wash:   rgba(242, 240, 234, 0.10);
+  --vl-verify:        #4fbb8a;
+  --vl-verify-wash:   rgba(79, 187, 138, 0.14);
+  --vl-caution:       #d9a441;
+  --vl-caution-wash:  rgba(217, 164, 65, 0.14);
+  --vl-danger:        #e0776a;
+  --vl-danger-wash:   rgba(224, 119, 106, 0.14);
+  --vl-scrim:         rgba(0, 0, 0, 0.62);
+  --vl-shadow-1: 0 1px 2px rgba(0, 0, 0, .35);
+  --vl-shadow-2: 0 4px 12px -2px rgba(0, 0, 0, .48), 0 2px 4px -2px rgba(0, 0, 0, .35);
+  --vl-shadow-3: 0 18px 48px -12px rgba(0, 0, 0, .62), 0 6px 16px -8px rgba(0, 0, 0, .48);
+  color-scheme: dark;
+}
+
+@media (min-width: 768px) {
+  :root { --vl-header-h: 80px; --vl-gutter: 24px; }
+}
+
+@media (min-width: 1280px) {
+  :root { --vl-gutter: 32px; }
+}
+
+@media (min-width: 1440px) {
+  :root { --vl-container: min(100% - 2 * var(--vl-s6), 1280px); }
+}
+
+/* reduce-motion：状态/浮层/布局三档时长归零，舞台演示时长保留
+   （关掉动画不等于关掉信息，见方案 §7.2.7） */
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --vl-dur-1: 1ms;
+    --vl-dur-2: 1ms;
+    --vl-dur-3: 1ms;
+  }
+}
+
+/* ============================================================
+   过渡期兼容别名：旧 token 名 → 新 token。
+   仍有 .jsx 内联样式引用 var(--acc) / var(--display) / var(--mono) 等
+   （如 stages/text-reveal/Stage.jsx、entries.js）。三套调色板已收敛为
+   一套——这些名字只是同一套值的旧称呼。
+   WP-C / WP-D / WP-E / WP-F 迁完各自的 jsx 后，本段整体删除。
+   ============================================================ */
+:root {
