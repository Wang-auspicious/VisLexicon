+/* ============ 舞台 · 指针与手势 ============ */
+.pg {
+  width: 100%;
+  align-self: stretch;
+  min-height: 528px;
+  padding: var(--vl-s4) var(--vl-s5);
+  display: flex;
+  flex-direction: column;
+  gap: var(--vl-s3);
+  text-align: left;
+  font-size: var(--vl-fs-xs);
+}
+.pg-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--vl-s4); flex: 1; }
+.pg-frame {
+  position: relative;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+  background: var(--vl-surface-sunk);
+}
+.pg-frame-scroll { overflow-y: auto; place-items: start center; }
+.pg-scroll-filler { height: 900px; width: 1px; }
+.pg-bounds { position: absolute; inset: var(--pg-bounds); border: 1px dashed var(--vl-line-strong); border-radius: var(--vl-r-md); pointer-events: none; }
+.pg-tile {
+  position: relative;
+  z-index: 2;
+  display: grid;
+  place-items: center;
+  cursor: grab;
+  width: var(--pg-size);
+  height: var(--pg-size);
+  border-radius: var(--pg-radius);
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  user-select: none;
+  touch-action: none;
+}
+.pg-tile:active { cursor: grabbing; }
+.pg-tile-label { font-size: var(--vl-fs-xs); }
+.pg-tile-label.on { color: var(--vl-verify); }
+.pg-hold {
+  position: absolute;
+  left: var(--vl-s2);
+  right: var(--vl-s2);
+  bottom: var(--vl-s2);
+  height: 3px;
+  border-radius: 2px;
+  background: var(--vl-verify);
+  transform-origin: left center;
+}
+.pg-dropzone {
+  position: absolute;
+  right: var(--vl-s3);
+  bottom: var(--vl-s3);
+  display: grid;
+  place-items: center;
+  width: 96px;
+  height: 62px;
+  border: 1px dashed var(--vl-line-strong);
+  border-radius: var(--vl-r-sm);
+  color: var(--vl-ink-3);
+  font-size: var(--vl-fs-2xs);
+}
+.pg-side { display: flex; flex-direction: column; gap: var(--vl-s3); }
+.pg-press {
+  display: flex;
+  align-items: center;
+  gap: var(--vl-s2);
+  padding: var(--vl-s2) var(--vl-s3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  color: var(--vl-ink-3);
+}
+.pg-press i { width: var(--vl-s3); height: var(--vl-s3); border-radius: 50%; background: var(--vl-surface-sunk); transition: background var(--vl-dur-1), transform var(--vl-dur-1); }
+.pg-press[data-state="pressed"] i, .pg-press[data-state="armed"] i { background: var(--vl-caution); transform: scale(1.35); }
+.pg-press[data-state="dragging"] i, .pg-press[data-state="holding"] i { background: var(--vl-accent); transform: scale(1.5); }
+.pg-press[data-state="long-pressed"] i { background: var(--vl-verify); transform: scale(1.6); }
+.pg-focusring { padding: var(--vl-s2) var(--vl-s3); border: 1px solid var(--vl-line); border-radius: var(--vl-r-sm); color: var(--vl-ink); text-align: left; }
+.pg-dismiss {
+  padding: var(--vl-s3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink-3);
+  transition: opacity var(--vl-dur-2), transform var(--vl-dur-2);
+}
+.pg-dismiss.gone { opacity: 0.45; transform: translateX(12px); }
+.pg-reorder { display: flex; flex-direction: column; gap: var(--vl-s1); }
+.pg-reorder i {
+  font-style: normal;
+  padding: var(--vl-s1) 9px;
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-sm);
+  background: var(--vl-surface);
+  color: var(--vl-ink);
+}
+.pg-readout {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
+  gap: var(--vl-s2) var(--vl-s3);
+  margin: 0;
+  padding: var(--vl-s3);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-md);
+  background: var(--vl-surface);
+}
+.pg-readout div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.pg-readout dt { font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); }
+.pg-readout dd { margin: 0; font-family: var(--vl-mono); font-size: var(--vl-fs-2xs); color: var(--vl-ink); overflow-wrap: anywhere; }
+.pg-hint { margin: 0; color: var(--vl-ink-3); font-size: var(--vl-fs-2xs); }
