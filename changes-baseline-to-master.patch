+}
+.tr-preset-chips, .tr-font-chips { display: flex; align-items: center; gap: var(--vl-s1); }
+.tr-chip-btn, .tr-font-btn {
+  border: 0;
+  background: transparent;
+  padding: var(--vl-s1) 11px;
+  font-size: var(--vl-fs-2xs);
+  font-weight: var(--vl-fw-medium);
+  color: var(--vl-ink-3);
+  border-radius: var(--vl-r-pill);
+  cursor: pointer;
+  transition: all var(--vl-dur-1) var(--vl-ease-out);
+  white-space: nowrap;
+}
+.tr-chip-btn:hover, .tr-font-btn:hover { color: var(--vl-ink); background: var(--vl-surface); }
+.tr-chip-btn.on, .tr-font-btn.on {
+  background: var(--vl-accent);
+  color: var(--vl-accent-ink);
+  font-weight: var(--vl-fw-bold);
+}
+
+.tr-stage-canvas {
+  position: relative;
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
