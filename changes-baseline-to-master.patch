+.nv-tabs i.on { color: var(--vl-ink); border-bottom-color: var(--vl-accent); }
+.nv-content { display: flex; flex-direction: column; gap: 9px; padding: var(--vl-s1) 0 2px; }
+.nv-content i { height: 9px; border-radius: var(--vl-r-xs); background: var(--vl-surface-sunk); }
+.nv-pagination { display: flex; gap: var(--vl-s1); }
