+
+.tr-specimen-toolbar {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--vl-s4);
+  padding: var(--vl-s1) var(--vl-s3);
+  background: var(--vl-surface-sunk);
+  border: 1px solid var(--vl-line);
+  border-radius: var(--vl-r-pill);
+  box-shadow: var(--vl-shadow-1);
