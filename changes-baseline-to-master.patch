+.nv-lang { padding: 2px var(--vl-s2); border-radius: var(--vl-r-pill); background: var(--vl-surface); color: var(--vl-ink-3); font-size: var(--vl-fs-2xs); }
+.nv-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--vl-s3); margin-top: var(--vl-s3); }
+.nv-rail { display: flex; flex-direction: column; gap: var(--vl-s3); }
+.nv-menubar { display: flex; flex-direction: column; gap: 2px; padding: 5px; border: 1px solid var(--vl-line); border-radius: var(--nv-radius); }
+.nv-menubar i { font-style: normal; padding: var(--vl-s1) 9px; border-radius: var(--vl-r-xs); color: var(--vl-ink-3); }
+.nv-menubar i.on { background: var(--vl-accent-wash); color: var(--vl-ink); }
+.nv-anchor { display: flex; flex-direction: column; gap: var(--vl-s1); padding: var(--vl-s2) var(--vl-s3); border-left: 2px solid var(--vl-line); }
+.nv-anchor em { font-style: normal; font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); letter-spacing: 0.06em; }
+.nv-anchor i { font-style: normal; color: var(--vl-ink-3); }
+.nv-main { display: flex; flex-direction: column; gap: var(--vl-s3); min-width: 0; }
+.nv-breadcrumb { display: flex; align-items: center; gap: var(--vl-s1); color: var(--vl-ink-3); }
+.nv-breadcrumb span:last-child { color: var(--vl-ink); }
+.nv-toprow { position: relative; display: flex; align-items: center; gap: var(--vl-s3); }
+.nv-back { color: var(--vl-ink); }
+.nv-toolbar { display: flex; gap: var(--vl-s1); padding: 3px; border: 1px solid var(--vl-line); border-radius: var(--nv-radius); }
+.nv-toolbar i { display: grid; place-items: center; width: var(--vl-s6); height: var(--vl-s6); border-radius: 5px; font-style: normal; color: var(--vl-ink-3); }
+.nv-menubtn { padding: 5px 11px; border: 1px solid var(--vl-line); border-radius: var(--nv-radius); color: var(--vl-ink); }
+.nv-menu {
+  position: absolute;
+  top: calc(100% + 6px);
