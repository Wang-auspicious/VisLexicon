+}
+.tr-idle:hover { border-bottom-color: var(--vl-line-strong); }
+
+.tr-specimen-input {
+  font-size: var(--tr-size);
+  font-family: var(--tr-font, var(--vl-sans));
+  font-weight: var(--vl-fw-bold);
+  color: var(--vl-ink);
+  text-align: center;
+  background: transparent;
+  border: 0;
+  border-bottom: 2px solid var(--vl-accent);
+  outline: none;
+  width: 100%;
+  min-width: 320px;
+  padding: 0 var(--vl-s1);
+}
+
+.tr-hint { margin: 0; font-size: var(--vl-fs-2xs); color: var(--vl-ink-3); letter-spacing: 0.01em; }
+
+/* 排版度量标尺 */
+.tr-metrics-overlay { position: absolute; inset: -16px -44px; pointer-events: none; z-index: 5; }
+.tr-guide {
+  position: absolute;
+  left: 0;
+  right: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+.tr-guide-badge {
+  font-size: var(--vl-fs-2xs);
+  font-family: var(--vl-mono);
+  font-weight: var(--vl-fw-bold);
+  padding: 1px var(--vl-s1);
+  border-radius: var(--vl-r-xs);
+  background: var(--vl-surface);
+  border: 1px solid var(--vl-line);
+  box-shadow: var(--vl-shadow-1);
+}
+.tr-guide-val {
+  font-size: var(--vl-fs-2xs);
+  font-family: var(--vl-mono);
+  font-style: normal;
+  padding: 1px 5px;
+  border-radius: 3px;
+  background: var(--vl-surface-sunk);
+  border: 1px solid var(--vl-line);
+}
+.tr-guide-cap { top: 18%; border-bottom: 1px dashed var(--vl-verify); }
+.tr-guide-cap .tr-guide-badge { color: var(--vl-verify); border-color: var(--vl-verify); }
+.tr-guide-x { top: 38%; border-bottom: 1px dotted var(--vl-ink-3); }
+.tr-guide-x .tr-guide-badge { color: var(--vl-ink-2); border-color: var(--vl-line-strong); }
+.tr-guide-base { top: 78%; border-bottom: 1.5px solid var(--vl-danger); }
+.tr-guide-base .tr-guide-badge { color: var(--vl-danger); font-weight: var(--vl-fw-bold); border-color: var(--vl-danger); }
+.tr-guide-desc { bottom: 6%; border-bottom: 1px dashed var(--vl-caution); }
+.tr-guide-desc .tr-guide-badge { color: var(--vl-caution); border-color: var(--vl-caution); }
+
+/* 镜面金属：改用中性阶梯，不再是彩色装饰 */
+.tr-chrome {
+  background: linear-gradient(180deg,
+    var(--vl-surface) 0%,
+    var(--vl-line) 18%,
+    var(--vl-line-strong) 42%,
+    var(--vl-ink) 48%,
+    var(--vl-ink-2) 52%,
+    var(--vl-ink-3) 70%,
+    var(--vl-line) 88%,
+    var(--vl-surface) 100%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+.tr-deboss {
+  color: color-mix(in srgb, var(--vl-surface) 80%, var(--vl-ink-3));
+  font-weight: var(--vl-fw-bold);
+}
+
+/* 逐字动力学 */
+.tr-chars .tr-ch {
+  display: inline-block;
+  white-space: pre;
+  animation-delay: var(--tr-delay);
+  animation-duration: var(--tr-dur);
+  animation-timing-function: var(--vl-ease-out);
+  animation-fill-mode: both;
+}
+.tr-fade .tr-ch { animation-name: trFade; }
+.tr-blur .tr-ch { animation-name: trBlur; }
+.tr-morph .tr-ch { animation-name: trMorph; }
+.tr-typewriter .tr-ch { animation-name: trType; animation-duration: 1ms; }
+.tr-streaming .tr-ch { animation-name: trFade; animation-duration: calc(var(--tr-dur) * 0.4); }
+
+@keyframes trFade {
+  from { opacity: 0; transform: translateY(var(--tr-travel)); }
+  to { opacity: 1; transform: translateY(0); }
+}
+@keyframes trBlur {
+  from { opacity: 0; filter: blur(16px); transform: translateY(var(--tr-travel)) scale(1.08); }
+  to { opacity: 1; filter: blur(0); transform: translateY(0) scale(1); }
+}
+@keyframes trMorph {
+  from { opacity: 0; filter: blur(12px); transform: scaleX(1.4) scaleY(0.7); }
+  to { opacity: 1; filter: blur(0); transform: scale(1); }
+}
+@keyframes trType { from { opacity: 0; } to { opacity: 1; } }
+
+.tr-caret {
+  display: inline-block;
+  width: 2.5px;
+  height: 0.88em;
+  margin-left: var(--vl-s1);
+  vertical-align: -0.06em;
+  background: var(--vl-ink);
+  border-radius: 1px;
+  animation: trCaret 0.8s steps(2) infinite;
+}
+@keyframes trCaret { 50% { opacity: 0; } }
+
+.tr-mask {
+  clip-path: inset(0 100% 0 0);
+  animation: trMask var(--tr-dur) var(--vl-ease-io) both;
+}
+@keyframes trMask { to { clip-path: inset(0 0 0 0); } }
+
+.tr-marquee-vp {
+  overflow: hidden;
+  width: 100%;
+  -webkit-mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
+  mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
+}
+.tr-marquee-track { display: flex; width: max-content; animation: trMarquee 10s linear infinite; }
+.tr-marquee-item { white-space: pre; }
+@keyframes trMarquee { to { transform: translateX(-33.333%); } }
+
+.tr-shimmer {
+  background: linear-gradient(110deg, var(--vl-ink-3) 20%, var(--vl-ink) 45%, var(--vl-surface) 50%, var(--vl-ink) 55%, var(--vl-ink-3) 80%);
+  background-size: 250% 100%;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: trShimmer 2.4s var(--vl-ease-io) infinite;
+}
+@keyframes trShimmer {
+  from { background-position: 180% 0; }
+  to { background-position: -80% 0; }
+}
+
+.tr-stack {
+  display: inline-grid;
+  grid-template-areas: "stack";
+  place-items: center;
+  position: relative;
+  min-height: calc(var(--tr-size) * 1.3);
+  min-width: max-content;
+}
+.tr-cross {
+  grid-area: stack;
+  white-space: nowrap;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity var(--tr-dur) var(--vl-ease-out), transform var(--tr-dur) var(--vl-ease-out);
+  transform: scale(0.96);
+}
+.tr-cross.on { opacity: 1; pointer-events: auto; transform: scale(1); }
+
+/* 洗色揭示 */
+.tr-scrub {
+  background: linear-gradient(90deg, var(--vl-ink) 0%, var(--vl-ink) 50%, var(--vl-ink-3) 50%, var(--vl-ink-3) 100%);
+  background-size: 250% 100%;
+  background-position: 100% 0;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  animation: trScrub 2.5s var(--vl-ease-out) both;
+}
+@keyframes trScrub { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
+
+/* 3D 翻转浮现 */
+.tr-tumble .tr-ch {
+  transform-origin: 50% 100%;
+  animation-name: trTumble;
+  perspective: 1000px;
+}
+@keyframes trTumble {
+  0% { opacity: 0; transform: translateY(calc(var(--tr-travel) * 1.5)) rotateX(-80deg); }
+  100% { opacity: 1; transform: none; }
+}
+
+/* 故障干扰 */
+.tr-glitch-box { position: relative; display: inline-block; }
+.tr-glitch { position: relative; color: var(--vl-ink); animation: trGlitchAnim 2.5s infinite; }
+.tr-glitch::before, .tr-glitch::after {
+  content: attr(data-text);
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  opacity: 0.8;
+}
+.tr-glitch::before {
+  left: 2px;
+  text-shadow: -2px 0 var(--vl-danger);
+  clip-path: inset(10% 0 30% 0);
+  animation: trGlitchAnim2 2.2s infinite linear alternate-reverse;
+}
+.tr-glitch::after {
+  left: -2px;
+  text-shadow: -2px 0 var(--vl-verify);
+  clip-path: inset(60% 0 10% 0);
+  animation: trGlitchAnim3 2.8s infinite linear alternate-reverse;
+}
+@keyframes trGlitchAnim {
+  0%, 10%, 100% { transform: skewX(0); }
+  11% { transform: skewX(8deg); }
+  12% { transform: skewX(-8deg); }
+  13% { transform: skewX(0); }
+}
+@keyframes trGlitchAnim2 {
+  0%, 100% { clip-path: inset(10% 0 30% 0); }
+  25% { clip-path: inset(40% 0 10% 0); }
+  50% { clip-path: inset(20% 0 60% 0); }
+}
+@keyframes trGlitchAnim3 {
+  0%, 100% { clip-path: inset(60% 0 10% 0); }
+  35% { clip-path: inset(10% 0 80% 0); }
+  65% { clip-path: inset(80% 0 10% 0); }
+}
