+.tr-specimen-wrap { position: relative; display: inline-block; max-width: 100%; }
+
+.tr-line {
+  margin: 0;
+  font-size: var(--tr-size);
+  line-height: 1.25;
+  font-family: var(--tr-font, var(--vl-sans));
+  font-weight: var(--vl-fw-bold);
+  color: var(--vl-ink);
+  letter-spacing: calc(-0.02em + var(--tr-spacing, 0px));
+  transition: letter-spacing var(--vl-dur-2) var(--vl-ease-out);
+  user-select: none;
+  white-space: nowrap;
+}
+
+.tr-idle {
