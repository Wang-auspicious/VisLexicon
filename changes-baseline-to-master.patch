@@ -0,0 +1,2146 @@
+/* ============================================================
+   图鉴：工作台外壳 + 九台舞台自带样式。
+   规则从 src/atlas.css 机械搬运，选择器名不变；WP-F / WP-G 会重排。
+
+   本次搬运一并处理的三件事：
+   1. 颜色/字号/圆角/阴影全部换成 tokens.css 的 --vl-*；
+   2. 断点从 max-width 1180 / 860 改写为 min-width 768 / 1280 的移动优先结构；
+   3. 删掉假 macOS 红黄绿窗框 `.mac-dot`（方案 §7.1 第 3 条，纯装饰无功能）
+      与全息彩虹字 `.tr-holo`（无法用一套语义色表达，且属装饰色）。
+   ============================================================ */
+
+.ax-mac-desktop {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  min-height: 560px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: var(--vl-s2) var(--vl-s5) var(--vl-s4);
+  box-sizing: border-box;
+  overflow: hidden;
+}
+
+.ax-mac-window {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  max-width: 1600px;
+  background: var(--vl-surface);
+  border-radius: var(--vl-r-md);
+  border: 1px solid var(--vl-line);
+  box-shadow: var(--vl-shadow-2);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  transition: all var(--vl-dur-3) var(--vl-ease-out);
+}
+
+/* ===== 窗口标题栏 ===== */
+.ax-mac-titlebar {
+  flex: none;
+  height: 46px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
