+            <tbody>
+              {COLLECTIONS.map((group) => (
+                <tr key={group.id}>
+                  <th scope="row"><a className="inline-link" href="#/">{group.titleZh}</a></th>
+                  <td>{group.blurbZh}</td>
+                  <td className="ab-value">{group.entryIds.length}</td>
+                  <td className="ab-value x-mono">{group.createdAt}</td>
