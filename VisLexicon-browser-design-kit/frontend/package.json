{
  "name": "vislexicon-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/build-public-data.mjs",
    "prebuild": "node scripts/build-public-data.mjs",
    "build": "vite build",
    "lint": "oxlint src scripts playwright.config.js",
    "preview": "vite preview",
    "shots": "npm run build && node scripts/shots.mjs",
    "a11y": "npm run build && node scripts/a11y-check.mjs",
    "tokens": "node scripts/check-tokens.mjs",
    "tokens:strict": "node scripts/check-tokens.mjs --strict",
    "tokens:baseline": "node scripts/check-tokens.mjs --baseline"
  },
  "dependencies": {
    "@projectwallace/css-analyzer": "^9.9.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.2.2"
  }
}
