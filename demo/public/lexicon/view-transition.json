  "notation": "M[vt] · api:stVT · old:fade-out · new:rise-in",
  "genes": [
    {
      "gene": "快照",
      "value": "旧页截图 → 改 DOM → 新页截图"
    },
    {
      "gene": "共享元素",
      "value": "view-transition-name 配对"
    },
    {
      "gene": "降级",
      "value": "不支持时直接切换，无感退化"
    }
  ],
  "minimal_code": {
    "css": "document.startViewTransition(() => updateDOM());\n::view-transition-old(root){animation:fade-out .2s}\n::view-transition-new(root){animation:fade-in .25s}"
  },
  "params": [],
  "anti_patterns": [
    "过渡超 400ms 用户开始等；快门感要轻。"
