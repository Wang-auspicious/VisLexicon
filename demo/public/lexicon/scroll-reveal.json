    "aos"
  ],
  "definition_zh": "元素进入视口时才播放进场动画，配合 stagger 更有节奏。",
  "notation": "I[reveal] · trigger:io.2 · y:16→0 · once:true",
  "genes": [
    {
      "gene": "触发线",
      "value": "视口下缘 up 10–20% 处"
    },
    {
      "gene": "一次 or 往复",
      "value": "once:true 是主流"
    }
  ],
  "minimal_code": {
    "css": "const io = new IntersectionObserver(es =>\n  es.forEach(e => e.isIntersecting && e.target.classList.add('in')))\n.div{opacity:0;translate:0 16px;transition:.6s}\n.div.in{opacity:1;translate:0 0}"
  },
  "params": [],
  "anti_patterns": [
    "所有东西都飞入等于没有进场；一屏一两个焦点即可。"
  ],
  "tech_notes": [
    "IntersectionObserver 懒触发；reduced-motion 直接显示。"
  ],
  "common_pairings": [
    "stagger-reveal"
  ],
  "related": [
    "scroll-scrub"
  ],
