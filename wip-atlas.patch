+  }, [go])
+
+  /* 键盘：←/→ 在本台术语间移动。只在焦点不在录入控件上时生效
+   * （方案 §7.4 第 4 条：旧版没排除 select，用键盘操作枚举下拉会同时切术语）。 */
+  const onKeyDown = useCallback((event) => {
+    const el = event.target
+    const tag = el?.tagName
