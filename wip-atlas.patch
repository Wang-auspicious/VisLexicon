+    const at = flow.indexOf(termId)
+    const step = event.key === 'ArrowRight' ? 1 : -1
+    event.preventDefault()
+    selectTerm(flow[(at + step + flow.length) % flow.length])
+  }, [model, termId, go, selectTerm])
