+  }, [stage])
+
+  /* 站点索引只在舞台页用得上一次：术语面板的「真实网站里长这样」。 */
+  useEffect(() => {
+    let alive = true
+    fetch('/data/site-index.json')
+      .then((res) => (res.ok ? res.json() : null))
+      .then((data) => { if (alive) setSites(data) })
+      .catch(() => { if (alive) setSites(null) })
