    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright-core": "^1.63.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
