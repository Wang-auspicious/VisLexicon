{
  "name": "vislexicon-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/start-dev.mjs",
    "check": "node scripts/check-demo.mjs",
    "prebuild": "npm run build:bench && node scripts/ingest-v6/seed-native.mjs && node scripts/resources/build-index.mjs && node scripts/build-browser-snapshot.mjs && node scripts/build-atlas-catalog.mjs && node scripts/style/check-published.mjs && npm run check && node scripts/assert-public-budget.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "security:push": "node scripts/check-push-secrets.mjs",
    "lint": "oxlint src server scripts vite.config.js",
    "test": "npm run check && node --test tests/*.test.mjs",
    "social:watchlist": "node scripts/social-discovery.mjs watchlist",
    "social:collect": "node scripts/social-discovery.mjs collect",
    "social:ingest": "node scripts/social-discovery.mjs ingest",
    "social:verify": "node scripts/social-discovery.mjs verify",
    "site:graph": "node scripts/site-graph/cli.mjs",
    "build:bench": "node scripts/build-component-bench.mjs",
    "predev": "npm run build:bench && node scripts/ingest-v6/seed-native.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright-core": "^1.63.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "component-bench"
  ]
}
