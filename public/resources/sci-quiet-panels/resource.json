      "code"
    ],
    [
      "quiet.mplstyle",
      "template"
    ],
    [
      "figure.svg",
      "output"
    ],
    [
      "figure.pdf",
      "output"
    ],
    [
      "figure.png",
      "output"
    ]
  ],
  "previews": [
    "figure.png"
  ],
  "run": {
    "runtime": "python",
    "requires": [
      "numpy",
      "matplotlib>=3.8"
    ],
    "command": "python make_figure.py --out figure",
    "outputs": {
      "figure.svg": "可编辑矢量",
      "figure.pdf": "投稿用，字体可编辑（fonttype 42）",
      "figure.png": "300dpi 预览"
    },
    "limits": {
      "zh": "显著性用正态近似，正式投稿请换 scipy 的 Welch t 检验；示例数据是随机生成的。",
