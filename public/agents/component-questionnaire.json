        "target"
      ],
      "na": true
    },
    {
      "id": "state.feedback",
      "stage": "04-states",
      "prompt": "feedback 状态：如何触发？看到什么变化？作用到哪个元素？列检查步骤和结果；不存在需源码或 DOM 理由。",
      "fields": [
        "action",
        "result",
        "target"
      ],
      "na": true
    },
    {
      "id": "motion",
      "stage": "05-motion",
      "prompt": "列每条运动 trigger/target/property/from/to/unit/durationMs/delayMs/easing/iterations/direction/cycleMs/staggerMs/exit/interruption；静态则 active=false、tracks=[] 并给观察时长和检查步骤。",
      "fields": [
        "active",
        "tracks",
        "inspection"
      ],
      "numbers": [
        "observationMs"
      ]
    },
    {
      "id": "pointer",
      "stage": "05-motion",
      "prompt": "是否根据坐标跟随鼠标，还是固定 hover 动作？如何区分？",
      "fields": [
        "coordinateDriven",
        "test",
        "result"
      ]
    },
    {
      "id": "reducedMotion",
      "stage": "05-motion",
      "prompt": "减少动效设置下的实际结果，或精确源码规则；无规则也必须核实。禁止把源码核实称设备实测。",
      "fields": [
        "method",
        "result"
      ]
    },
    {
      "id": "responsive",
      "stage": "06-context",
      "prompt": "至少两个不同 CSS 视口。逐个填 widthPx/heightPx、组件 width/height、换行、溢出；写实际改变和适用范围。",
      "fields": [
        "viewports",
        "conclusion"
      ]
    },
    {
      "id": "touch",
      "stage": "06-context",
      "prompt": "触屏下行为如何？写测试设备/模拟方法或来源代码证据；不能假定 hover 自动支持触屏。",
      "fields": [
        "method",
        "result"
      ]
    },
    {
      "id": "keyboard",
      "stage": "06-context",
      "prompt": "Tab/Shift+Tab/Enter/Space 实际如何？是否能看到焦点，是否意外触发？非交互图形填角色与不适用理由。",
      "fields": [
        "method",
        "result"
      ],
      "na": true
    },
    {
      "id": "accessibility",
      "stage": "06-context",
      "prompt": "DOM 语义、可访问名称、contrast 检查方法及数值或无文字依据；不要泛称符合 WCAG。",
      "fields": [
        "role",
        "name",
        "contrast",
        "limitations"
      ]
    },
    {
      "id": "implementation",
      "stage": "07-reconstruct",
      "prompt": "实际实现证据是什么？示例依赖、可确认的源码版本/属性、许可证事实和复用边界分别是什么？",
      "fields": [
        "basis",
        "dependencies",
        "version",
        "reuseBoundary"
      ]
    },
    {
      "id": "distinction",
      "stage": "07-reconstruct",
      "prompt": "与最近的相似款相比，哪些可测差别必须保留？至少两个差别，不能只换名称。",
      "fields": [
        "nearest",
        "differences"
      ]
    },
    {
      "id": "description",
      "stage": "07-reconstruct",
      "prompt": "一份完整中文描述与对应英文。按对象→几何→色彩/字体→交互→响应范围；不出现内部编号、未核实承诺或重复摘要。",
      "fields": [
        "zh",
        "en"
      ]
    },
    {
      "id": "reconstruction",
      "stage": "07-reconstruct",
      "prompt": "按协议给严格重建 prompt，包含结构、px/颜色/文字参数、状态和运动、响应范围、不能添加的效果。",
      "fields": [
        "prompt",
        "avoid"
      ]
    },
    {
      "id": "retrieval",
      "stage": "07-reconstruct",
      "prompt": "标签按对象/结构/形状/色彩/材质/排版/运动/触发/上下文分轴；中英同义词；至少3条口语正例及2条易混负例。",
      "fields": [
        "facets",
        "aliases",
        "positive",
        "negative"
      ]
    }
  ]
}
