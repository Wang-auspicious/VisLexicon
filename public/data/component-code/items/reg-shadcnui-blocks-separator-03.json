    <Button variant=\"outline\">\n              <svg\n                fill=\"currentColor\"\n                height=\"1em\"\n                stroke=\"currentColor\"\n                strokeWidth=\"0\"\n                viewBox=\"0 0 512 512\"\n                width=\"1em\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <path d=\"M391.17,103.47H352.54v109.7h38.63ZM285,103H246.37V212.75H285ZM120.83,0,24.31,91.42V420.58H140.14V512l96.53-91.42h77.25L487.69,256V0ZM449.07,237.75l-77.22,73.12H294.61l-67.6,64v-64H140.14V36.58H449.07Z\" />\n              </svg>\n              Sign up with Twitch\n            </Button>\n            <Button variant=\"outline\">\n              <svg\n                fill=\"currentColor\"\n                height=\"1em\"\n                stroke=\"currentColor\"\n                strokeWidth=\"0\"\n                viewBox=\"0 0 512 512\"\n                width=\"1em\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <path d=\"M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z\" />\n              </svg>\n              Sign up with Twitter\n            </Button>\n          </div>\n        </form>\n      </CardContent>\n    </Card>\n  );\n}\n","originalPath":"src/components/customized/separator/separator-03.tsx","sourceUrl":"https://github.com/akash3444/shadcn-ui-blocks/blob/73a69e9e458ed3633897445f6588f8a001f43f29/src/components/customized/separator/separator-03.tsx","sha256":"63177418aa6a4cecd89f1b5a1cbc90f74abb1bbd0a990b23e9a93d2bd0cc3541"}],"dependencies":[],"commit":"73a69e9e458ed3633897445f6588f8a001f43f29","controls":[],"preview":{"status":"verified","url":"/data/component-code/previews/reg-shadcnui-blocks-separator-03/index.html","posterUrl":"/data/component-code/posters/reg-shadcnui-blocks-separator-03.jpg","controls":[]},"status":"source-ready","lane":"source","