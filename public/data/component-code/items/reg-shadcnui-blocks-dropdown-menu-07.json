cide-react\";\nimport { Avatar, AvatarImage } from \"@/registry/ui/avatar\";\nimport {\n  DropdownMenu,\n  DropdownMenuCheckboxItem,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuSub,\n  DropdownMenuSubContent,\n  DropdownMenuSubTrigger,\n  DropdownMenuTrigger,\n} from \"@/registry/ui/dropdown-menu\";\n\nexport default function ComplexDropdownMenu() {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger className=\"flex items-center gap-3\">\n        <Avatar>\n          <AvatarImage src=\"https://github.com/shadcn.png\" />\n        </Avatar>\n        <div className=\"flex flex-col text-start\">\n          <p className=\"font-medium text-sm\">My Workspace</p>\n          <p className=\"text-muted-foreground text-xs\">myworkspace.slack.com</p>\n        </div>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent className=\"mt-2 w-72\">\n        <DropdownMenuItem className=\"py-3\">\n          <Avatar>\n            <AvatarImage src=\"https://github.com/shadcn.png\" />\n          </Avatar>\n          <div className=\"ml-1 flex flex-col\">\n            <p className=\"font-medium text-sm\">My Workspace</p>\n            <p className=\"text-muted-foreground text-xs\">\n              myworkspace.slack.com\n            </p>\n          </div>\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem className=\"flex-col items-start\">\n          <div className=\"flex items-center gap-1\">\n            <Rocket className=\"mr-1 h-[18px] w-[18px]\" />\n            <span className=\"font-medium leading-none\">Upgrade</span>\n          </div>\n          <p className=\"text-muted-foreground\">\n            You&apos;re on a free version of Slack.\n          </p>\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <User className=\"mr-1\" /> Invite people\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <Settings2 className=\"mr-1\" /> Preferences\n        </DropdownMenuItem>\n        <DropdownMenuSub>\n          <DropdownMenuSubTrigger>\n            <Filter className=\"mr-1\" />\n            Filter sidebar\n          </DropdownMenuSubTrigger>\n          <DropdownMenuSubContent>\n            <DropdownMenuSub>\n              <DropdownMenuSubTrigger>Activity</DropdownMenuSubTrigger>\n              <DropdownMenuSubContent>\n                <DropdownMenuCheckboxItem checked>\n                  All activity\n                </DropdownMenuCheckboxItem>\n                <DropdownMenuCheckboxItem>\n                  Unread messaged only\n                </DropdownMenuCheckboxItem>\n                <DropdownMenuCheckboxItem>\n                  Mentions only\n                </DropdownMenuCheckboxItem>\n                <DropdownMenuCheckboxItem>\n                  Customize by section\n                </DropdownMenuCheckboxItem>\n              </DropdownMenuSubContent>\n            </DropdownMenuSub>\n            <DropdownMenuSub>\n              <DropdownMenuSubTrigger>People</DropdownMenuSubTrigger>\n              <DropdownMenuSubContent>\n                <DropdownMenuCheckboxItem checked>\n                  Everyone\n                </DropdownMenuCheckboxItem>\n                <DropdownMenuCheckboxItem>\n                  Without external people\n                </DropdownMenuCheckboxItem>\n                <DropdownMenuCheckboxItem>\n                  Including external people\n                </DropdownMenuCheckboxItem>\n              </DropdownMenuSubContent>\n            </DropdownMenuSub>\n          </DropdownMenuSubContent>\n        </DropdownMenuSub>\n        <DropdownMenuSub>\n          <DropdownMenuSubTrigger>\n            <Bolt className=\"mr-1\" />\n            Tools & settings\n          </DropdownMenuSubTrigger>\n          <DropdownMenuSubContent className=\"w-52\">\n            <DropdownMenuLabel>Tools</DropdownMenuLabel>\n            <DropdownMenuItem>Customize workspace</DropdownMenuItem>\n            <DropdownMenuItem>Workspace builder</DropdownMenuItem>\n            <DropdownMenuItem>\n              Workspace analytics <ExternalLink className=\"ml-auto\" />\n            </DropdownMenuItem>\n            <DropdownMenuSeparator />\n            <DropdownMenuLabel>Administration</DropdownMenuLabel>\n            <DropdownMenuItem>Manage apps</DropdownMenuItem>\n          </DropdownMenuSubContent>\n        </DropdownMenuSub>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>\n          <LogIn className=\"mr-1\" /> Sign in on mobile\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <LogOut className=\"mr-1\" /> Sign out\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  );\n}\n","originalPath":"src/components/customized/dropdown-menu/dropdown-menu-07.tsx","sourceUrl":"https://github.com/akash3444/shadcn-ui-blocks/blob/73a69e9e458ed3633897445f6588f8a001f43f29/src/components/customized/dropdown-menu/dropdown-menu-07.tsx","sha256":"52344e03f04b406ac1e94e1d2405657eadda855c434c5026d1daf3151e6277f7"}],"dependencies":["lucide-react"],"commit":"73a69e9e458ed3633897445f6588f8a001f43f29","controls":[],"preview":{"status":"verified","url":"/data/component-code/previews/reg-shadcnui-blocks-dropdown-menu-07/index.html","posterUrl":"/data/component-code/posters/reg-shadcnui-blocks-dropdown-menu-07.jpg","controls":[]},"status":"source-ready","lane":"source","install":"npx shadcn@latest add \"https://www.shadcnui-blocks.com/r/dropdown-menu-07.json\""}